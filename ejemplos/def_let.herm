scene "Lets" {
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 1.5, 5];
        target:   [0, 0, 0];
        fov:      50;
    }
    background: [0.05, 0.05, 0.1];
}

let TAU = pi * 2;
let RADIO = 1.0;
let ALTURA = RADIO * 1.5;
let BRILLO = 0.3;

light "sol" {
    type: directional;
    direction: [0.5, 0.8, 0.3];
    color: [1, 1, 1];
    intensity: BRILLO;
}

material "metal" {
    base_color: [0.8, 0.6, 0.3];
    metallic: 1.0;
    roughness: 0.2;
}

material "suelo" {
    base_color: [0.2, 0.2, 0.3];
    roughness: 0.8;
}

node "esfera" {
    sdf: sphere(RADIO);
    material: "metal";
    position: [0, RADIO, 0];
}

node "plano" {
    sdf: plane(0, 1, 0, 0);
    material: "suelo";
}
