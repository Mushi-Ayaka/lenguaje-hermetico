scene "Lets avanzados" {
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 2, 6];
        target:   [0, 0, 0];
        fov:      50;
    }
    background: [0.05, 0.05, 0.1];
}

let PI = 3.14159265;
let TAU = PI * 2;
let MITAD = 0.5;
let ESCALA = 1.0;

material "metal" {
    base_color: [0.8, 0.6, 0.3];
    metallic: 1.0;
    roughness: 0.2;
}

// Parametrized def usando let
def "tornillo"(altura, radio) {
    sdf: cylinder(radio * ESCALA, altura * MITAD);
    material: "metal";
}

node "uno" {
    instance "tornillo"(1.0, 0.2) { position: [-0.8, 0, 0]; }
}

node "dos" {
    instance "tornillo"(TAU * 0.3, 0.15) { position: [0.8, 0, 0]; }
}
