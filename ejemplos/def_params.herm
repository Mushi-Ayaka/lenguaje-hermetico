scene "DefParams" {
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 0.5, 3];
        target:   [0, 0.4, 0];
        fov:      50;
    }
    background: [0.05, 0.05, 0.1];
}

material "metal_rojo" {
    base_color: [0.8, 0.2, 0.1];
    roughness: 0.3;
    metallic: 1.0;
}

def "pata"(h, r) {
    sdf: cylinder(r, h);
    material: "metal_rojo";
    position: [0, h/2, 0];
}

node "mesa" {
    instance "pata"(0.8, 0.05) { position: [-0.4, 0, -0.3]; }
    instance "pata"(0.8, 0.05) { position: [ 0.4, 0, -0.3]; }
    instance "pata"(0.8, 0.05) { position: [-0.4, 0,  0.3]; }
    instance "pata"(0.8, 0.05) { position: [ 0.4, 0,  0.3]; }

    node "tablero" {
        sdf: box(1.0, 0.05, 0.8);
        material: "metal_rojo";
        position: [0, 0.4, 0];
    }
}
