scene "Instancias" {
    axes { X: 800, Y: 600, W: 1 }
    camera {
        position: [0, 2, 6];
        target: [0, 1, 0];
        fov: 45;
    }
    background: [0.02, 0.02, 0.06];
}

material "cobre" {
    base_color: [0.72, 0.45, 0.2];
    roughness: 0.3;
    metallic: 1.0;
}

def "pata" {
    mode: solid;
    sdf: cylinder(0.04, 0.8);
    material: "cobre";
    position: [0, 0, 0];
}

node "mesa" {
    node "tablero" {
        sdf: box(2.0, 0.1, 1.2);
        material: "cobre";
        position: [0, 0.8, 0];
    }

    instance "pata" { position: [-0.8, 0.4, -0.5]; }
    instance "pata" { position: [0.8, 0.4, -0.5]; }
    instance "pata" { position: [-0.8, 0.4, 0.5]; }
    node "pata_extra" {
        instance "pata" { position: [0.8, 0.4, 0.5]; }
    }
}
