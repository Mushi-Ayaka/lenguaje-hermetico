scene "SdfExpr" {
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 0, 3];
        target:   [0, 0, 0];
        fov:      50;
    }
    background: [0.05, 0.05, 0.1];
}

material "rojo" {
    base_color: [0.9, 0.1, 0.1];
    roughness:  0.3;
    metallic:   0.8;
}

material "azul" {
    base_color: [0.1, 0.1, 0.9];
    roughness:  0.5;
    metallic:   0.0;
}

node "esfera_expr" {
    sdf: sphere(1.5 * 0.5);    // = 0.75, con expresión aritmética
    material: "rojo";
    position: [-0.8, 0, 0];
}

node "esfera_const" {
    sdf: sphere(0.75);          // constante
    material: "azul";
    position: [0.8, 0, 0];
}
