scene "SdfExpr_Param" {
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 0.5, 3];
        target:   [0, 0, 0];
        fov:      50;
    }
    background: [0.05, 0.05, 0.1];
}

material "metal" {
    base_color: [0.8, 0.6, 0.2];
    roughness:  0.3;
    metallic:   1.0;
}

def "cilindro_rad"(rad) {
    sdf: cylinder(rad * 0.5, 1.0);   // expresión en SDF param
    material: "metal";
    position: [0, 0.5, 0];
}

node "grupo" {
    instance "cilindro_rad"(0.8) { position: [-0.6, 0, 0]; }
    instance "cilindro_rad"(1.2) { position: [ 0.6, 0, 0]; }
}
