// ============================================================
// LIBRERÍA: std_astro_mechanics.hm
// CAPA:     8.1 — Mecánica Celeste y Órbitas
// VERSIÓN:  0.2
// FUENTE:   Leyes de Kepler, Límite de Roche, Problema de los 2 Cuerpos
// DEPS:     std_math_core.hm, std_phys_kinematics.hm
// FECHA:    6 de junio de 2026
// ============================================================

import "std_math_core.hm";
import "std_phys_kinematics.hm";

// ============================================================
// DINÁMICA ORBITAL AVANZADA
// ============================================================

// Tercera Ley de Kepler (generalizada): T^2 = 4*pi^2*a^3 / (G*(M1+M2))
fn "kepler_period"(a_semi_major, M1, M2, G_const) {
    sqrt((4.0 * sq(PI) * cb(a_semi_major)) / (G_const * (M1 + M2) + EPSILON))
}

// Velocidad de escape (incluyendo relatividad mínima): v_e = sqrt(2GM/r)
fn "escape_velocity"(M_mass, r_distance, G_const) {
    sqrt((2.0 * G_const * M_mass) / (r_distance + EPSILON))
}

// Límite de Roche (cuerpo rígido): d = R_M * (2 * rho_M / rho_m)^(1/3)
fn "roche_limit_rigid"(R_primary, rho_primary, rho_satellite) {
    R_primary * pow(2.0 * rho_primary / (rho_satellite + EPSILON), 0.333333)
}

// Vis-viva equation: v^2 = GM * (2/r - 1/a)
fn "vis_viva_velocity"(G_const, M_mass, r_distance, a_semi_major) {
    sqrt(G_const * M_mass * (2.0 / (r_distance + EPSILON) - 1.0 / (a_semi_major + EPSILON)))
}

// ============================================================
// SDFs ASTROFÍSICOS MACROSCÓPICOS
// ============================================================

// Anillos planetarios (disco plano con huecos)
def "planetary_rings"(r_inner, r_outer, thickness) {
    sdf: custom(
        max(
            abs(y) - thickness,
            max(r_inner - sqrt(x*x + z*z), sqrt(x*x + z*z) - r_outer)
        )
    );
}

// Asteroide irregular (base elipsoidal con FBM de baja frecuencia)
def "asteroid_shape"(rx, ry, rz, noise_amp, sc_val) {
    sdf: custom(
        sqrt(sq(x/rx) + sq(y/ry) + sq(z/rz)) - 1.0 - noise_amp * fbm3d_4(x * sc_val, y * sc_val, z * sc_val)
    );
}
