// EJEMPLO 2: Dinámica de metilación
let methylation_next = dna_methylation_dynamics(0.8, 0.05, 0.02);  // 0.8 → 0.81

// EJEMPLO 3: Doble hélice de ADN
instance "dna_example" {
    position: [0, 0, 0];
    sdf: dna_double_helix(0.1, 3.4, 0.34, 0.1);
}

// EJEMPLO 4: Patrón de metilación
instance "methylation_example" {
    position: [2, 0, 0];
    sdf: cpg_methylation_pattern(1.0, 0.6, 0.1);
}
*/

// ============================================================
// NOTAS PARA USUARIOS
// ============================================================

// 1. La genética estudia la herencia y variación de caracteres
// 2. La epigenética estudia modificaciones heredables que no alteran la secuencia de ADN
// 3. Los modelos son simplificaciones pedagógicas de fenómenos complejos
// 4. Las constantes son valores típicos para visualización
// 5. La precisión científica requiere ajustes específicos por organismo

// ============================================================
// "El genoma es la partitura, la epigenética es la interpretación."
// ============================================================