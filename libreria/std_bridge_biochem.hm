// BIOQUÍMICA: Estructura y función de biomoléculas, enzimas, metabolismo,
// membranas biológicas, señalización celular, estructura proteica

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES BIOQUÍMICAS
// ============================================================

// Constantes físicas bioquímicas
let AVOGADRO_NUMBER = 6.02214076e23;        // N_A (mol⁻¹)
let GAS_CONSTANT = 8.314462618;            // R (J/(mol·K))
let R = GAS_CONSTANT;                       // Alias
let FARADAY_CONSTANT = 96485.33212;        // F (C/mol)
let BOLTZMANN_CONSTANT = 1.380649e-23;     // k_B (J/K)

// Constantes escaladas
let NA = AVOGADRO_NUMBER / 1e23;           // N_A escalado
let RT = R * 310.15;                       // RT a 37°C (escalado)
let KB_T = 0.0267;                         // k_BT a 37°C (escalado)

// Tamaños moleculares típicos (Å, escalados)
let AMINO_ACID_LENGTH = 3.8;               // Longitud de aminoácido en proteína
let BASE_PAIR_LENGTH = 3.4;                // Distancia entre pares de bases en DNA
let LIPID_BILAYER_THICKNESS = 40.0;        // Espesor de bicapa lipídica
let PROTEIN_RADIUS_TYPICAL = 20.0;         // Radio típico de proteína globular

// Constantes de reacción
let MICHAELIS_CONSTANT_TYPICAL = 1e-3;     // K_M típico (M)
let TURNOVER_NUMBER_TYPICAL = 1e3;         // k_cat típico (s⁻¹)

// ============================================================
// INTERFAZ PÚBLICA - ESTRUCTURA PROTEICA (fn)
// ============================================================

// --- Ángulo de Enlace Peptídico (ω) ---
// ω ≈ 180° para enlace peptídico plano (trans)
fn "peptide_bond_angle"() {
    pi  // 180° en radianes
}

// --- Ángulos de Torsión de Cadena Principal (φ, ψ) ---
// Restringidos por mapa de Ramachandran
fn "ramachandran_phi_psi_allowed"(phi, psi) {
    // Regiones permitidas en mapa de Ramachandran (step con borde invertido = cota superior)
    let region1 = step(-pi*0.75, phi) * step(phi, -pi*0.25) * step(-pi*0.5, psi) * step(psi, pi*0.5);
    let region2 = step(pi*0.25, phi) * step(phi, pi*0.75) * step(-pi*0.5, psi) * step(psi, pi*0.5);
    region1 + region2
}

// --- Distancia de Enlace Cα-Cα en Hélice α ---
// 5.4Å entre Cα separados por 4 residuos (i, i+4)
fn "alpha_helix_ca_distance"(residue_separation) {
    1.5 * residue_separation  // Aproximación escalada
}

// --- Radio de Hélice α ---
// ~2.3Å radio del cilindro de hélice
fn "alpha_helix_radius"() {
    0.6  // Escalado
}

// --- Paso de Hélice α (Avance por residuo) ---
// 1.5Å por residuo en dirección del eje
fn "alpha_helix_rise_per_residue"() {
    0.4  // Escalado
}

// --- Distancia de Enlace en Lámina β ---
// 3.5Å entre cadenas adyacentes en lámina β
fn "beta_sheet_interstrand_distance"() {
    0.9  // Escalado
}

// --- Ángulo entre Cadenas en Lámina β (Antiparalela vs Paralela) ---
fn "beta_sheet_strand_angle"(antiparallel) {
    antiparallel * pi * 0.5  // 90° vs 0°
}

// ============================================================
// INTERFAZ PÚBLICA - ENLACES Y INTERACCIONES (fn)
// ============================================================

// --- Energía de Enlace de Hidrógeno (Proteína) ---
// 2-8 kcal/mol, típicamente ~5 kcal/mol
fn "hydrogen_bond_energy"(distance, angle) {
    let ideal_distance = 2.8;  // Å
    let ideal_angle = pi * 0.5;  // 90°
    let dist_term = exp(-(distance - ideal_distance)*(distance - ideal_distance) / 0.5);
    let angle_term = cos(angle - ideal_angle)*cos(angle - ideal_angle);
    5.0 * dist_term * angle_term  // kcal/mol escalado
}

// --- Energía de Interacción Hidrofóbica ---
// ΔG ≈ -1.3 kcal/mol por Å² de área superficial enterrada
fn "hydrophobic_interaction_energy"(buried_area) {
    -1.3 * buried_area  // kcal/mol·Å² escalado
}

// --- Energía de Interacción Iónica (Sal) ---
// U = (q₁·q₂)/(4π·ε·ε₀·r) en medio acuoso (ε ≈ 80)
fn "ionic_interaction_energy"(q1, q2, distance) {
    let dielectric_water = 80.0;
    332.0 * q1 * q2 / (dielectric_water * distance)  // kcal/mol escalado
}

// --- Energía de Interacción de van der Waals (Lennard-Jones) ---
fn "van_der_waals_energy"(epsilon, sigma, distance) {
    4.0 * epsilon * (pow(sigma/distance, 12.0) - pow(sigma/distance, 6.0))
}

// --- Potencial de Campo de Fuerza (Aproximación armónica) ---
fn "force_field_harmonic"(k, r, r0) {
    0.5 * k * (r - r0) * (r - r0)
}

// --- Potencial de Campo de Fuerza (Morse para enlaces) ---
fn "force_field_morse"(De, a, r, r0) {
    De * (1.0 - exp(-a * (r - r0))) * (1.0 - exp(-a * (r - r0)))
}

// ============================================================
// INTERFAZ PÚBLICA - CINÉTICA ENZIMÁTICA (fn)
// ============================================================

// --- Ecuación de Michaelis-Menten ---
// v = V_max·[S]/(K_M + [S])
fn "michaelis_menten_velocity"(Vmax, Km, substrate_concentration) {
    Vmax * substrate_concentration / (Km + substrate_concentration + 1e-6)
}

// --- Constante de Especificidad (k_cat/K_M) ---
fn "enzyme_specificity_constant"(kcat, Km) {
    kcat / (Km + 1e-6)
}

// --- Ecuación de Lineweaver-Burk (Doble Recíproco) ---
// 1/v = 1/V_max + K_M/(V_max·[S])
fn "lineweaver_burk_reciprocal"(Vmax, Km, substrate_concentration) {
    1.0/Vmax + Km/(Vmax * substrate_concentration + 1e-6)
}

// --- Inhibición Competitiva ---
// v = V_max·[S]/(K_M·(1+[I]/K_i) + [S])
fn "competitive_inhibition_velocity"(Vmax, Km, Ki, substrate_concentration, inhibitor_concentration) {
    Vmax * substrate_concentration / (Km * (1.0 + inhibitor_concentration/Ki) + substrate_concentration + 1e-6)
}

// --- Inhibición No Competitiva ---
// v = V_max·[S]/((K_M + [S])·(1+[I]/K_i))
fn "noncompetitive_inhibition_velocity"(Vmax, Km, Ki, substrate_concentration, inhibitor_concentration) {
    Vmax * substrate_concentration / ((Km + substrate_concentration) * (1.0 + inhibitor_concentration/Ki) + 1e-6)
}

// --- Inhibición a Competencia (Mixed) ---
fn "mixed_inhibition_velocity"(Vmax, Km, Ki, substrate_concentration, inhibitor_concentration) {
    let alpha_factor = 1.0 + inhibitor_concentration/Ki;
    Vmax * substrate_concentration / (Km * alpha_factor + substrate_concentration * alpha_factor + 1e-6)
}

// --- Activación Alostérica (Ecuación de Hill) ---
// v = V_max·[S]ⁿ/(K₀.₅ⁿ + [S]ⁿ)
fn "hill_equation_cooperative"(Vmax, K_half, hill_coefficient, substrate_concentration) {
    Vmax * pow(substrate_concentration, hill_coefficient) / 
    (pow(K_half, hill_coefficient) + pow(substrate_concentration, hill_coefficient) + 1e-6)
}

// ============================================================
// INTERFAZ PÚBLICA - TERMODINÁMICA BIOQUÍMICA (fn)
// ============================================================

// --- Energía Libre de Gibbs para Reacción Bioquímica ---
// ΔG = ΔG⁰ + RT·ln(Q)
fn "biochemical_gibbs_free_energy"(deltaG0, Q) {
    deltaG0 + RT * log(Q + 1e-6)
}

// --- Constante de Equilibrio a partir de ΔG⁰ ---
// K_eq = exp(-ΔG⁰/(RT))
fn "biochemical_equilibrium_constant"(deltaG0) {
    exp(-deltaG0 / RT)
}

// --- Energía de Hidratación (Transferencia de Agua a No Polar) ---
// ΔG_hyd ≈ 1-2 kcal/mol por grupo CH₂
fn "hydrophobic_hydration_energy"(num_ch2_groups) {
    1.5 * num_ch2_groups  // kcal/mol escalado
}

// --- Energía de Desnaturalización Térmica (Van't Hoff) ---
// ΔG_denat = ΔH - T·ΔS
fn "protein_denaturation_free_energy"(deltaH, deltaS, T) {
    deltaH - T * deltaS
}

// --- Temperatura de Desnaturalización (Tm) ---
// T_m = ΔH/ΔS cuando ΔG = 0
fn "protein_melting_temperature"(deltaH, deltaS) {
    deltaH / (deltaS + 1e-6)
}

// --- Coeficiente de Partición Octanol-Agua (log P) ---
// Predicción de hidrofobicidad
fn "octanol_water_partition_coefficient"(num_carbons, num_polar_groups) {
    let hydrophobicity = 0.5 * num_carbons - 1.0 * num_polar_groups;
    hydrophobicity
}

// ============================================================
// INTERFAZ PÚBLICA - MEMBRANAS BIOLÓGICAS (fn)
// ============================================================

// --- Potencial de Membrana (Ecuación de Nernst) ---
// E = (RT/(zF))·ln([ion]_out/[ion]_in)
fn "nernst_membrane_potential"(z, concentration_out, concentration_in) {
    (RT/(z * 96485.0)) * log(concentration_out/(concentration_in + 1e-6) + 1e-6)
}

// --- Potencial de Goldman-Hodgkin-Katz (Na⁺, K⁺, Cl⁻) ---
// V_m = (RT/F)·ln( (P_Na·[Na]_out + P_K·[K]_out + P_Cl·[Cl]_in) /
//                  (P_Na·[Na]_in  + P_K·[K]_in  + P_Cl·[Cl]_out) )
fn "goldman_hodgkin_katz_potential"(p_na, na_out, na_in, p_k, k_out, k_in, p_cl, cl_out, cl_in) {
    (RT/96485.0) * log((p_na*na_out + p_k*k_out + p_cl*cl_in + 1e-6) / (p_na*na_in + p_k*k_in + p_cl*cl_out + 1e-6))
}

// --- Fluidez de Membrana (Orden de parámetro) ---
fn "membrane_fluidity_order_parameter"(temperature, cholesterol_content) {
    // Mayor temperatura → menor orden, mayor colesterol → mayor orden
    exp(-temperature/300.0) * (1.0 + 0.5 * cholesterol_content)
}

// --- Curvatura de Membrana (Energía de Helfrich) ---
// E = (κ/2)·∫(H - H₀)²·dA + κ_G·∫K·dA
fn "membrane_bending_energy"(kappa, H, H0, kappa_G, K) {
    0.5 * kappa * (H - H0) * (H - H0) + kappa_G * K
}

// --- Transición de Fase de Membrana (Gel a Líquido) ---
fn "membrane_phase_transition"(temperature, transition_temperature, cooperativity) {
    0.5 + 0.5 * tanh(cooperativity * (temperature - transition_temperature))
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs BIOQUÍMICAS (def con custom)
// ============================================================

// --- Hélice α (Estructura secundaria) ---
def "alpha_helix_structure"(radius, pitch, residues, residue_spacing) {
    // Tubo alrededor de una curva helicoidal parametrizada por x
    sdf: custom(sqrt(sq(x - radius*cos(x*10.0*pitch)) + sq(y - x*10.0*residue_spacing) + sq(z - radius*sin(x*10.0*pitch))) - 0.2);
}

// --- Lámina β (Estructura secundaria) ---
def "beta_sheet_structure"(strand_length, strand_width, strand_spacing, antiparallel) {
    // Hebras repetidas en z; las antiparalelas se desplazan en y
    sdf: custom(sqrt(sq(x)/(strand_length*strand_length) + sq(y - floor(z/strand_spacing)*(antiparallel*0.2))/(0.1*0.1) + sq(mod(z, strand_spacing) - strand_spacing*0.5)/(strand_width*strand_width)) - 1.0);
}

// --- Proteína Globular (Esfera con rugosidad) ---
def "globular_protein"(radius, surface_roughness, core_density) {
    // Núcleo denso + superficie rugosa
    sdf: custom(sqrt(x*x + y*y + z*z) - radius*core_density + surface_roughness*(sin(x*5.0) + sin(y*5.0) + sin(z*5.0))*0.1);
}

// --- Membrana Lipídica (Bicapa) ---
def "lipid_bilayer"(thickness, fluidity, curvature) {
    // Dos capas lipídicas + curvatura de membrana + rugosidad térmica
    sdf: custom(min(abs(y - thickness*0.25) - thickness*0.1, abs(y + thickness*0.25) - thickness*0.1) + curvature*(x*x + z*z)*0.01 + fluidity*(sin(x*3.0 + w) + sin(z*3.0 + w*1.5))*0.05);
}

// --- Sitio Activo Enzimático (Pocket) ---
def "enzyme_active_site"(pocket_radius, entrance_width, specificity) {
    // Pocket esférico con entrada estrecha + patrón de complementariedad
    sdf: custom(max(sqrt(x*x + y*y + z*z) - pocket_radius, abs(y) - entrance_width) + specificity*(sin(x*8.0)*sin(z*8.0))*0.1);
}

// --- Canales Iónicos (Poros en membrana) ---
def "ion_channel"(pore_radius, selectivity_filter_length, gating_state) {
    // Poro cilíndrico (eje y) con filtro de selectividad; cerrado = campo muy alto
    sdf: custom(max(sqrt(x*x + z*z) - pore_radius, min(abs(y) - selectivity_filter_length*0.5, sqrt(x*x + z*z) - pore_radius*0.5)) + (1.0 - gating_state)*10.0);
}

// --- ADN de Doble Hélice ---
def "dna_double_helix"(helix_radius, pitch, base_pair_spacing) {
    // Dos hebras helicoidales (eje y) + pares de bases como segmentos horizontales
    sdf: custom(min(
        min(
            sqrt(sq(x - helix_radius*cos(y*10.0*pitch)) + sq(z - helix_radius*sin(y*10.0*pitch))) - 0.05,
            sqrt(sq(x + helix_radius*cos(y*10.0*pitch)) + sq(z + helix_radius*sin(y*10.0*pitch))) - 0.05
        ),
        segment_distance(x, y, z, helix_radius*cos(y*10.0*pitch), y, helix_radius*sin(y*10.0*pitch), -helix_radius*cos(y*10.0*pitch), y, -helix_radius*sin(y*10.0*pitch)) - 0.1
    ));
}

// ============================================================
// INTERFAZ PÚBLICA - SISTEMAS BIOQUÍMICOS (def)
// ============================================================

// --- Complejo Enzima-Sustrato (Michaelis) ---
def "enzyme_substrate_complex"(enzyme_radius, substrate_radius, binding_affinity) {
    // Enzima grande, sustrato unido en el sitio activo (desplazado)
    sdf: custom(min(
        sqrt(x*x + y*y + z*z) - enzyme_radius,
        min(
            sqrt(sq(x - enzyme_radius*0.7) + y*y + z*z) - substrate_radius,
            sqrt(x*x + y*y + z*z) - enzyme_radius*0.8
        )
    ));
}

// --- Cadena de Transporte de Electrones (Mitocondria) ---
def "electron_transport_chain"(complex_spacing, membrane_thickness) {
    // Membrana interna mitocondrial + 4 complejos espaciados a lo largo del eje x
    sdf: custom(min(
        abs(y) - membrane_thickness*0.5,
        min(
            min(
                sqrt(sq(x + complex_spacing*1.5) + y*y + z*z) - 0.2,
                sqrt(sq(x + complex_spacing*0.5) + y*y + z*z) - 0.2
            ),
            min(
                sqrt(sq(x - complex_spacing*0.5) + y*y + z*z) - 0.2,
                sqrt(sq(x - complex_spacing*1.5) + y*y + z*z) - 0.2
            )
        )
    ));
}

// --- Ciclo de Krebs (Metabolismo) ---
def "krebs_cycle_metabolism"(cycle_radius, metabolite_count) {
    // Anillo de reacciones con metabolitos como nódulos periódicos en θ
    sdf: custom(abs(sqrt(x*x + z*z) - cycle_radius) - 0.05 - 0.03*(0.5 + 0.5*cos(metabolite_count*atan(z, x))));
}

// --- Transducción de Señal (Receptor-Ligando) ---
def "signal_transduction_complex"(receptor_size, ligand_size, amplification_factor) {
    // Receptor elipsoidal + ligando unido + señal radial pulsante
    sdf: custom(min(
        sqrt(sq(x)/(receptor_size*receptor_size) + sq(y)/(0.2*0.2) + sq(z)/(receptor_size*receptor_size)) - 1.0,
        min(
            sqrt(sq(x - receptor_size*0.8) + y*y + z*z) - ligand_size,
            sqrt(x*x + y*y + z*z) - amplification_factor*0.1*sin(w*5.0)
        )
    ));
}

