// BIOLOGÍA QUÍMICA: Aplicación de herramientas químicas a problemas biológicos,
// sondas moleculares, moduladores de proteínas, química combinatoria

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES FUNDAMENTALES
// ============================================================

let BOLTZMANN_CHEMBIO = 1.380649e-23;          // k_B (J/K)
let AVOGADRO_CHEMBIO = 6.02214076e23;          // N_A (mol⁻¹)
let GAS_CONSTANT_CHEMBIO = 8.314462618;        // R (J/(mol·K))

// ============================================================
// INTERFAZ PÚBLICA - SONDAS MOLECULARES (fn)
// ============================================================

// --- Brillo de Sonda Fluorescente ---
// Brillo relativo = Φ·ε
fn "fluorescent_probe_efficiency"(quantum_yield, extinction_coefficient) {
    quantum_yield * extinction_coefficient
}

// --- Ratio de Señal/Fondo ---
fn "signal_to_background_ratio"(fluorescence_bound, fluorescence_free, binding_constant) {
    (fluorescence_bound - fluorescence_free) / (fluorescence_free + 1e-6) * binding_constant
}

// --- Fotoblanqueo (Fotostabilidad) ---
fn "photobleaching_rate"(excitation_intensity, photosensitizer_concentration, oxygen_level) {
    excitation_intensity * photosensitizer_concentration * oxygen_level * 1e-3
}

// --- Desplazamiento Espectral (Stokes Shift) ---
fn "stokes_shift"(absorption_wavelength, emission_wavelength) {
    emission_wavelength - absorption_wavelength
}

// --- Transferencia de Energía (FRET) ---
// donor_emission/acceptor_absorption: solapamiento espectral (reservado)
fn "fret_efficiency"(donor_emission, acceptor_absorption, distance, forster_radius) {
    // E = R₀⁶/(R₀⁶ + r⁶)
    pow(forster_radius, 6.0) / (pow(forster_radius, 6.0) + pow(distance, 6.0) + 1e-12)
}

// ============================================================
// INTERFAZ PÚBLICA - INHIBIDORES Y MODULADORES (fn)
// ============================================================

// --- Inhibición Competitiva ---
fn "competitive_inhibition_ic50"(ki, substrate_concentration, km) {
    // IC50 = Ki·(1 + [S]/Km)
    ki * (1.0 + substrate_concentration / (km + 1e-6))
}

// --- Inhibición No Competitiva ---
fn "noncompetitive_inhibition_ic50"(ki) {
    // IC50 = Ki
    ki
}

// --- Índice de Selectividad ---
fn "selectivity_index"(ic50_target, ic50_offtarget) {
    ic50_offtarget / (ic50_target + 1e-6)
}

// --- Ventana Terapéutica ---
fn "therapeutic_window"(toxic_dose, effective_dose) {
    toxic_dose / (effective_dose + 1e-6)
}

// --- Factor de Ligando (Ligand Efficiency) ---
// LE = -ΔG/(N_heavy·RT) — ΔG de unión en J/mol (resultado adimensional)
fn "ligand_efficiency"(binding_energy, heavy_atom_count) {
    -binding_energy / (heavy_atom_count * GAS_CONSTANT_CHEMBIO * 298.0)
}

// --- Lipophilic Ligand Efficiency ---
fn "lipophilic_ligand_efficiency"(pic50, logP) {
    // LLE = pIC50 - logP
    pic50 - logP
}

// ============================================================
// INTERFAZ PÚBLICA - QUÍMICA COMBINATORIA (fn)
// ============================================================

// --- Tamaño de Librería Combinatoria ---
fn "combinatorial_library_size"(building_blocks_per_position, number_of_positions) {
    pow(building_blocks_per_position, number_of_positions)
}

// --- Diversidad Molecular ---
// Diversidad a partir de la similitud de un par (p. ej. tanimoto_similarity)
fn "molecular_diversity"(similarity, similarity_threshold) {
    (1 - step(similarity_threshold, similarity)) * 0.5 + 0.5
}

// --- Cobertura del Espacio Químico ---
// Un compuesto de librería contra 2 puntos de referencia (2D)
fn "chemical_space_coverage"(lx, ly, r1x, r1y, r2x, r2y, radius) {
    let dist1 = sqrt(sq(r1x - lx) + sq(r1y - ly));
    let dist2 = sqrt(sq(r2x - lx) + sq(r2y - ly));
    
    let covered1 = 1.0 - step(radius, dist1);
    let covered2 = 1.0 - step(radius, dist2);
    
    (covered1 + covered2) * 0.5
}

// --- Similitud de Tanimoto ---
// Versión escalar para huellas de 2 bits por compuesto
fn "tanimoto_similarity"(fp1_bit0, fp1_bit1, fp2_bit0, fp2_bit1) {
    let intersection = step(0.5, fp1_bit0) * step(0.5, fp2_bit0) +
                      step(0.5, fp1_bit1) * step(0.5, fp2_bit1);
    let union_count = step(0.5, fp1_bit0) + step(0.5, fp2_bit0) +
                step(0.5, fp1_bit1) + step(0.5, fp2_bit1) - intersection;
    
    intersection / (union_count + 1e-6)
}

// ============================================================
// INTERFAZ PÚBLICA - ACTIVIDAD BIOLÓGICA (fn)
// ============================================================

// --- Relación Estructura-Actividad (QSAR) ---
// Versión escalar para 2 descriptores
fn "qsar_prediction"(descriptor1, descriptor2, coefficient1, coefficient2, intercept) {
    intercept + coefficient1 * descriptor1 + coefficient2 * descriptor2
}

// --- Regla de los 5 de Lipinski ---
fn "lipinski_rule_of_five"(molecular_weight, logP, h_bond_donors, h_bond_acceptors) {
    // Número de violaciones de las reglas de Lipinski
    step(500, molecular_weight) + step(5, logP) + step(5, h_bond_donors) + step(10, h_bond_acceptors)
}

// --- Fracción Sp3 (Carbonos saturados) ---
fn "sp3_fraction"(sp3_carbons, total_carbons) {
    sp3_carbons / (total_carbons + 1e-6)
}

// --- Complejidad Molecular ---
fn "molecular_complexity"(ring_count, stereocenters, bond_count, heavy_atoms) {
    // Score de complejidad
    ring_count * 2.0 + stereocenters * 3.0 + bond_count / (heavy_atoms + 1e-6) * 0.5
}

// --- Puntaje de Fármaco (Drug-likeness) ---
fn "druglikeness_score"(mw, logP, hbd, hba, rotatable_bonds, aromatic_rings) {
    // Score de fármaco (versión algebraica)
    let score = 1.0;
    let penalty_mw = step(500, mw) * 0.2;
    let penalty_logP_high = step(5, logP) * 0.15;
    let penalty_logP_low = step(-1, -logP) * 0.15;
    let penalty_hbd = step(5, hbd) * 0.1;
    let penalty_hba = step(10, hba) * 0.1;
    let penalty_rot = step(10, rotatable_bonds) * 0.1;
    let penalty_aromatic = step(4, aromatic_rings) * 0.1;
    
    max(0.0, score - penalty_mw - penalty_logP_high - penalty_logP_low - 
               penalty_hbd - penalty_hba - penalty_rot - penalty_aromatic)
}

// ============================================================
// INTERFAZ PÚBLICA - ETIQUETADO Y CONJUGACIÓN (fn)
// ============================================================

// --- Eficiencia de Conjugación ---
fn "conjugation_efficiency"(reactant_concentration, product_concentration, time) {
    product_concentration / (reactant_concentration + 1e-6)
}

// --- Relación Flúor-Proteína (F/P Ratio) ---
fn "fluorophore_protein_ratio"(fluorophore_concentration, protein_concentration) {
    fluorophore_concentration / (protein_concentration + 1e-6)
}

// --- Grado de Sustitución ---
fn "degree_of_substitution"(modified_sites, total_sites) {
    modified_sites / (total_sites + 1e-6)
}

// --- Efecto de Etiquetado en Actividad ---
fn "labeling_activity_retention"(unlabeled_activity, labeled_activity) {
    labeled_activity / (unlabeled_activity + 1e-6)
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs DE BIOLOGÍA QUÍMICA (def)
// ============================================================

// --- Sonda Fluorescente ---
def "fluorescent_probe_visualization"(probe_size, emission_wavelength, intensity_threshold) {
    // Núcleo + anillo aromático de 6 átomos + nube π + grupo de unión
    sdf: union(
        union(
            union(sphere(probe_size),
                custom(sqrt(sq(x - probe_size*1.2) + sq(y) + sq(z)) - probe_size*0.3)),
            union(
                custom(sqrt(sq(x - probe_size*1.2*cos(1.0472)) + sq(y) + sq(z - probe_size*1.2*sin(1.0472))) - probe_size*0.3),
                custom(sqrt(sq(x - probe_size*1.2*cos(2.0944)) + sq(y) + sq(z - probe_size*1.2*sin(2.0944))) - probe_size*0.3)
            )
        ),
        union(
            union(
                custom(sqrt(sq(x - probe_size*1.2*cos(3.1416)) + sq(y) + sq(z - probe_size*1.2*sin(3.1416))) - probe_size*0.3),
                custom(sqrt(sq(x - probe_size*1.2*cos(4.1888)) + sq(y) + sq(z - probe_size*1.2*sin(4.1888))) - probe_size*0.3)
            ),
            union(
                custom(sqrt(sq(x - probe_size*1.2*cos(5.2360)) + sq(y) + sq(z - probe_size*1.2*sin(5.2360))) - probe_size*0.3),
                union(
                    custom(sqrt(x*x + y*y + z*z) - probe_size*(1.0 + (sin(w*emission_wavelength*0.01)*0.5 + 0.5))),
                    custom(sqrt(sq(x - probe_size*2.5) + y*y + z*z) - probe_size*0.5)
                )
            )
        )
    );
}

// --- FRET Par (Donador-Aceptor) ---
// La distancia se calcula de las posiciones; la eficiencia atenúa/sensibiliza las emisiones
def "fret_pair_visualization"(dx, dy, dz, ax, ay, az, forster_radius, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x - dx) + sq(y - dy) + sq(z - dz)) - 0.05),
                custom(sqrt(sq(x - ax) + sq(y - ay) + sq(z - az)) - 0.05)
            ),
            custom(segment_distance(x, y, z, dx, dy, dz, ax, ay, az) - 0.01*fret_efficiency(0.5, 0.5, sqrt(sq(ax - dx) + sq(ay - dy) + sq(az - dz)), forster_radius))
        ),
        union(
            custom(sqrt(sq(x - dx) + sq(y - dy) + sq(z - dz)) - 0.08*(1.0 - fret_efficiency(0.5, 0.5, sqrt(sq(ax - dx) + sq(ay - dy) + sq(az - dz)), forster_radius))),
            custom(sqrt(sq(x - ax) + sq(y - ay) + sq(z - az)) - 0.08*fret_efficiency(0.5, 0.5, sqrt(sq(ax - dx) + sq(ay - dy) + sq(az - dz)), forster_radius))
        )
    );
}

// --- Inhibidor de Proteína ---
def "protein_inhibitor_visualization"(ix, iy, iz, affinity, intensity_threshold) {
    // Bolsillo rugoso + átomo de inhibidor + interacción + fuerza de unión
    sdf: union(
        union(
            custom(-x*x - y*y - z*z + 0.1 * (sin(x*10) + sin(z*10)) * 0.02 + 0.08),
            custom(sqrt(sq(x - ix) + sq(y - iy) + sq(z - iz)) - 0.03)
        ),
        union(
            custom(segment_distance(x, y, z, ix, iy, iz, ix + 0.1, iy + 0.1, iz) - 0.005),
            custom(sqrt(x*x + y*y + z*z) - 0.15*affinity)
        )
    );
}

// --- Librería Combinatoria (Representación) ---
// Anillo de puntos de diversidad (nódulos periódicos: frecuencia = diversity_points)
def "combinatorial_library_visualization"(sx, sy, sz, diversity_points, intensity_threshold) {
    sdf: union(
        union(
            custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.05),
            custom(max(abs(y - sy) - 0.03, abs(sqrt(sq(x - sx) + sq(z - sz)) - 0.15) - 0.02 - 0.015*cos(diversity_points*atan(z - sz, x - sx))))
        ),
        custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.25)
    );
}

// --- Etiquetado de Proteína ---
def "protein_labeling_visualization"(protein_radius, sx, sy, sz, fx, fy, fz, intensity_threshold) {
    // Superficie + sitio etiquetado + fluoróforo con emisión + enlace de conjugación
    sdf: union(
        union(
            union(sphere(protein_radius),
                custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.02)),
            custom(sqrt(sq(x - fx) + sq(y - fy) + sq(z - fz)) - 0.025)
        ),
        union(
            custom(sqrt(sq(x - fx) + sq(y - fy) + sq(z - fz)) - 0.04*(sin(w*2.0)*0.5 + 0.5)),
            custom(segment_distance(x, y, z, sx, sy, sz, fx, fy, fz) - 0.005)
        )
    );
}

// --- Modulador Alostérico ---
def "allosteric_modulator_visualization"(ox, oy, oz, ax, ay, az, mx, my, mz, intensity_threshold) {
    // Sitio ortostérico + sitio alostérico + modulador + comunicación + cambio conformacional
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x - ox) + sq(y - oy) + sq(z - oz)) - 0.06),
                custom(sqrt(sq(x - ax) + sq(y - ay) + sq(z - az)) - 0.05)
            ),
            custom(sqrt(sq(x - mx) + sq(y - my) + sq(z - mz)) - 0.025)
        ),
        union(
            custom(segment_distance(x, y, z, ox, oy, oz, ax, ay, az) - 0.01),
            custom(sin(x*3.0) * sin(z*3.0) * 0.05)
        )
    );
}

