// ENZIMOLOGÍA: Estudio de enzimas, mecanismos catalíticos, cinética enzimática,
// sitios activos, inhibición, regulación, evolución enzimática

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES FUNDAMENTALES
// ============================================================

let BOLTZMANN_ENZYME = 1.380649e-23;           // k_B (J/K)
let AVOGADRO_ENZYME = 6.02214076e23;           // N_A (mol⁻¹)
let GAS_CONSTANT_ENZYME = 8.314462618;         // R (J/(mol·K))
let PLANCK_ENZYME = 6.62607015e-34;            // h (J·s)

// ============================================================
// INTERFAZ PÚBLICA - CINÉTICA ENZIMÁTICA (fn)
// ============================================================

// --- Constante de Michaelis-Menten ---
fn "michaelis_menten_kinetics"(substrate_concentration, vmax, km) {
    vmax * substrate_concentration / (km + substrate_concentration)
}

// --- Constante de Especificidad (k_cat/K_M) ---
fn "specificity_constant"(kcat, km) {
    kcat / (km + 1e-6)
}

// --- Constante de Catalicidad (k_cat) ---
fn "turnover_number"(vmax, enzyme_concentration) {
    vmax / (enzyme_concentration + 1e-6)
}

// --- Aproximación de Estado Estacionario (Briggs-Haldane) ---
fn "steady_state_velocity"(k1, k_neg1, k2, substrate, enzyme) {
    // v = k2·[E]·[S]/(K_M + [S]) donde K_M = (k_neg1 + k2)/k1
    let km = (k_neg1 + k2) / k1;
    k2 * enzyme * substrate / (km + substrate)
}

// --- Competencia entre Múltiples Sustratos ---
// mechanism_type numérico: 0=ordered, 1=random, 2=ping-pong
fn "multi_substrate_competition"(vmax, substrateA, substrateB, kmA, kmB, mechanism_type) {
    let is_ordered = 1.0 - step(0.5, mechanism_type);
    let is_random = step(0.5, mechanism_type) * (1.0 - step(1.5, mechanism_type));
    let is_pingpong = step(1.5, mechanism_type);
    
    let v_ordered = vmax * substrateA * substrateB / (kmA * kmB + kmB * substrateA + substrateA * substrateB + 1e-6);
    let v_random = vmax * substrateA * substrateB / ((kmA + substrateA) * (kmB + substrateB) + 1e-6);
    let v_pingpong = vmax * substrateA * substrateB / (kmB * substrateA + kmA * substrateB + substrateA * substrateB + 1e-6);
    
    is_ordered * v_ordered + is_random * v_random + is_pingpong * v_pingpong
}

// --- Cinética de Reacción de Dos Sustratos ---
// mechanism numérico: 0=ordered bi-bi, 1=random bi-bi, 2=ping-pong
fn "two_substrate_kinetics"(substrate1, substrate2, mechanism, k1, k2, vmax) {
    let is_ordered = 1.0 - step(0.5, mechanism);
    let is_random = step(0.5, mechanism) * (1.0 - step(1.5, mechanism));
    let is_pingpong = step(1.5, mechanism);
    
    let v_ordered = vmax * substrate1 * substrate2 / (k1 * k2 + k2 * substrate1 + substrate1 * substrate2 + 1e-6);
    let v_random = vmax * substrate1 * substrate2 / ((k1 + substrate1) * (k2 + substrate2) + 1e-6);
    let v_pingpong = vmax * substrate1 * substrate2 / (k2 * substrate1 + k1 * substrate2 + substrate1 * substrate2 + 1e-6);
    
    is_ordered * v_ordered + is_random * v_random + is_pingpong * v_pingpong
}

// ============================================================
// INTERFAZ PÚBLICA - INHIBICIÓN ENZIMÁTICA (fn)
// ============================================================

// --- Inhibición Competitiva ---
fn "competitive_inhibition_velocity"(vmax, substrate, inhibitor, km, ki) {
    vmax * substrate / (km * (1.0 + inhibitor/ki) + substrate)
}

// --- Inhibición No Competitiva ---
fn "noncompetitive_inhibition_velocity"(vmax, substrate, inhibitor, km, ki) {
    (vmax / (1.0 + inhibitor/ki)) * substrate / (km + substrate)
}

// --- Inhibición Acompetitiva ---
fn "uncompetitive_inhibition_velocity"(vmax, substrate, inhibitor, km, ki) {
    vmax * substrate / (km + substrate * (1.0 + inhibitor/ki))
}

// --- Inhibición Mixta ---
// alpha_mixed y beta_mixed definen tipo de inhibición mixta
fn "mixed_inhibition_velocity"(vmax, substrate, inhibitor, km, alpha_mixed, beta_mixed) {
    vmax * substrate / (km * (1.0 + inhibitor/alpha_mixed) + substrate * (1.0 + inhibitor/beta_mixed))
}

// --- Inhibición por Retroalimentación ---
fn "feedback_inhibition"(activity, product_concentration, inhibition_constant, cooperativity) {
    activity * (1.0 - pow(product_concentration / (inhibition_constant + product_concentration), cooperativity))
}

// --- Desinhibición (Reactivación) ---
fn "enzyme_reactivation"(inhibited_fraction, reactivation_rate, time) {
    inhibited_fraction * exp(-reactivation_rate * time)
}

// ============================================================
// INTERFAZ PÚBLICA - CATÁLISIS ENZIMÁTICA (fn)
// ============================================================

// --- Aceleración Catalítica ---
fn "catalytic_rate_acceleration"(k_cat, k_uncat) {
    k_cat / (k_uncat + 1e-6)
}

// --- Eficiencia Catalítica ---
fn "catalytic_efficiency"(k_cat, km, k_uncat, substrate_concentration, enzyme_concentration) {
    let accelerated_rate = k_cat * enzyme_concentration / (km + substrate_concentration);
    let uncatalyzed_rate = k_uncat * substrate_concentration;
    
    accelerated_rate / (uncatalyzed_rate + 1e-6)
}

// --- Contribución de Energía Libre ---
fn "binding_energy_contribution"(delta_g_binding, delta_g_catalysis) {
    // Energía de unión utilizada para catálisis
    delta_g_binding - delta_g_catalysis
}

// --- Catálisis Ácido-Base General ---
fn "general_acid_base_catalysis"(ph, pka1, pka2) {
    // Fracción de catalizador en forma ácida/básica
    let fraction_acid = 1.0 / (1.0 + pow(10.0, ph - pka1));
    let fraction_base = 1.0 / (1.0 + pow(10.0, pka2 - ph));
    
    fraction_acid + fraction_base
}

// --- Catálisis Covalente ---
fn "covalent_catalysis_rate"(nucleophile_strength, electrophile_reactivity, leaving_group_ability) {
    nucleophile_strength * electrophile_reactivity * leaving_group_ability
}

// --- Catálisis de Tensión (Strain) ---
fn "strain_catalysis"(substrate_distortion, transition_state_complementarity) {
    // Energía de distorsión utilizada para catálisis
    substrate_distortion * transition_state_complementarity * 0.1
}

// ============================================================
// INTERFAZ PÚBLICA - SITIO ACTIVO (fn)
// ============================================================

// --- Composición del Sitio Activo ---
// Entradas numéricas: presencias (0/1) y conteos; devuelve índice de composición
fn "active_site_composition"(has_his, has_asp_glu, has_cys, num_metal_ions, num_cofactors) {
    step(0.5, has_his) + step(0.5, has_asp_glu) + step(0.5, has_cys) +
    step(0.5, num_metal_ions) + step(0.5, num_cofactors)
}

// --- Accesibilidad del Sitio Activo ---
fn "active_site_accessibility"(pore_radius, substrate_size, flexibility) {
    let size_ratio = substrate_size / (pore_radius + 1e-6);
    
    let below_ratio = 1.0 - step(0.8, size_ratio);
    let mid_ratio = step(0.8, size_ratio) * (1.0 - step(1.2, size_ratio));
    
    below_ratio * 1.0 * flexibility + mid_ratio * (1.5 - size_ratio) * flexibility
}

// --- Complementaridad al Estado de Transición ---
fn "transition_state_complementarity"(active_site_shape, transition_state_shape, induced_fit) {
    let shape_match = 1.0 - abs(active_site_shape - transition_state_shape) / (active_site_shape + 1e-6);
    shape_match * (1.0 + induced_fit * 0.3)
}

// --- Efecto de Entropía de Preorganización ---
fn "preorganization_entropy_gain"(substrate_conformation_entropy, active_site_rigidity) {
    // Ganancia por reducir entropía conformacional del sustrato
    substrate_conformation_entropy * active_site_rigidity * 0.5
}

// --- Desolvatación en Sitio Activo ---
fn "active_site_desolvation"(water_molecules_displaced, dielectric_constant) {
    // Energía de desolvatación
    water_molecules_displaced * 5.0 * (1.0 - 1.0/dielectric_constant)  // kcal/mol por molécula de agua
}

// ============================================================
// INTERFAZ PÚBLICA - REGULACIÓN ENZIMÁTICA (fn)
// ============================================================

// --- Alosterismo (Modelo de Monod-Wyman-Changeux) ---
fn "mwc_allosteric_model"(substrate_concentration, r_state, t_state, l0, c) {
    // Modelo MWC: L = [T]/[R] en ausencia de sustrato
    // c = Kr/Kt (diferencia de afinidad)
    let numerator = substrate_concentration * (1.0 + substrate_concentration) * (1.0 + r_state);
    let denominator = l0 * (1.0 + c * substrate_concentration) + (1.0 + substrate_concentration) * (1.0 + r_state);
    
    numerator / (denominator + 1e-6)
}

// --- Alosterismo (Modelo de Koshland-Némethy-Filmer) ---
fn "knf_allosteric_model"(substrate_concentration, binding_constant, cooperativity_factor) {
    // Modelo secuencial KNF
    let base_activity = substrate_concentration / (substrate_concentration + binding_constant);
    let cooperative_activity = pow(base_activity, cooperativity_factor);
    
    cooperative_activity
}

// --- Coeficiente de Hill ---
// n_H = Δlog(v/(V_max-v))/Δlog[S] para 2 puntos
fn "hill_coefficient"(substrate1, substrate2, activity1, activity2) {
    let log_ratio = log((activity2 * (1.0 - activity1)) / (activity1 * (1.0 - activity2) + 1e-6));
    let log_concentration = log(substrate2 / (substrate1 + 1e-6));
    
    log_ratio / (log_concentration + 1e-6)
}

// --- Regulación Covalente (Modificación) ---
fn "covalent_regulation"(active_state, modification_rate, demodification_rate) {
    let equilibrium = modification_rate / (modification_rate + demodification_rate + 1e-6);
    active_state * equilibrium
}

// --- Regulación por Compartimentalización ---
fn "compartmentalization_regulation"(enzyme_concentration, substrate_concentration, compartment_size) {
    // Concentración efectiva aumentada por compartimentalización
    enzyme_concentration * substrate_concentration / (compartment_size + 1e-6)
}

// --- Sensibilidad a Inhibidores ---
fn "inhibitor_sensitivity"(basal_activity, inhibited_activity, inhibitor_concentration) {
    (basal_activity - inhibited_activity) / (inhibitor_concentration + 1e-6)
}

// ============================================================
// INTERFAZ PÚBLICA - EVOLUCIÓN ENZIMÁTICA (fn)
// ============================================================

// --- Diversidad de Especificidad ---
// Índice tipo Shannon sobre 2 constantes de especificidad
fn "substrate_specificity_diversity"(specificity1, specificity2) {
    let max_specificity = max(specificity1, specificity2);
    let p1 = specificity1 / (max_specificity + 1e-6);
    let p2 = specificity2 / (max_specificity + 1e-6);
    
    -p1 * log(p1 + 1e-6) - p2 * log(p2 + 1e-6)
}

// --- Robustez Evolutiva ---
fn "evolutionary_robustness"(stability_mutations, activity_mutations) {
    // Fracción de mutaciones que no afectan función
    activity_mutations / (stability_mutations + activity_mutations + 1e-6)
}

// --- Promiscuidad Catalítica ---
// Suma de actividades secundarias relativas (2 actividades)
fn "catalytic_promiscuity"(main_activity, secondary_activity1, secondary_activity2) {
    (secondary_activity1 + secondary_activity2) / (main_activity + 1e-6)
}

// --- Evolución de Afinidad ---
fn "affinity_evolution"(ancestral_affinity, descendant_affinity, mutation_count) {
    // Cambio en afinidad por mutación
    (descendant_affinity - ancestral_affinity) / (mutation_count + 1e-6)
}

// --- Presión Selectiva en Sitio Activo ---
fn "active_site_selective_pressure"(conservation_score, functional_importance) {
    conservation_score * functional_importance
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs ENZIMOLÓGICOS (def)
// ============================================================

// --- Sitio Activo Enzimático ---
// Anillo de n residuos (nódulos periódicos) + cofactor + sustrato + 3 interacciones
def "enzyme_active_site_visualization"(n_residues, sx, sy, sz, cx, cy, cz, intensity_threshold) {
    sdf: union(
        sphere(0.08),
        union(
            custom(max(abs(z) - 0.02, abs(sqrt(x*x + y*y) - 0.1) - 0.015 - 0.012*cos(n_residues*atan(y, x)))),
            union(
                union(
                    custom(sqrt(sq(x - cx) + sq(y - cy) + sq(z - cz)) - 0.025),
                    custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.03)
                ),
                union(
                    union(
                        custom(segment_distance(x, y, z, 0.1, 0.0, 0.0, sx, sy, sz) - 0.005),
                        custom(segment_distance(x, y, z, 0.1*cos(2.0944), 0.1*sin(2.0944), 0.0, sx, sy, sz) - 0.005)
                    ),
                    custom(segment_distance(x, y, z, 0.1*cos(4.1888), 0.1*sin(4.1888), 0.0, sx, sy, sz) - 0.005)
                )
            )
        )
    );
}

// --- Mecanismo de Catálisis Ácido-Base ---
// Protón en tránsito según proton_transfer (0=ácido, 1=base)
def "acid_base_catalysis_visualization"(ax, ay, az, bx, by, bz, sx, sy, sz, proton_transfer, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x - ax) + sq(y - ay) + sq(z - az)) - 0.02),
                custom(sqrt(sq(x - bx) + sq(y - by) + sq(z - bz)) - 0.02)
            ),
            custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.025)
        ),
        union(
            custom(sqrt(sq(x - (ax + proton_transfer*(bx - ax))) + sq(y - (ay + proton_transfer*(by - ay))) + sq(z - (az + proton_transfer*(bz - az)))) - 0.01),
            custom(segment_distance(x, y, z, ax, ay, az, sx, sy, sz) - 0.006)
        )
    );
}

// --- Inhibición Competitiva ---
// Exclusión: el sitio activo se resta donde compiten sustrato e inhibidor
def "competitive_inhibition_visualization"(asx, asy, asz, sx, sy, sz, ix, iy, iz, binding_strength, intensity_threshold) {
    sdf: union(
        subtract(
            custom(sqrt(sq(x - asx) + sq(y - asy) + sq(z - asz)) - 0.06),
            union(
                custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.03),
                custom(sqrt(sq(x - ix) + sq(y - iy) + sq(z - iz)) - 0.025*binding_strength)
            )
        ),
        custom(sqrt(sq(x - asx) + sq(y - asy) + sq(z - asz)) - 0.1*binding_strength)
    );
}

// --- Alosterismo (Sitios Reguladores) ---
// Sitio catalítico + regulatorio + efector + comunicación + cambio conformacional
def "allosteric_regulation_visualization"(asx, asy, asz, lsx, lsy, lsz, ex, ey, ez, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x - asx) + sq(y - asy) + sq(z - asz)) - 0.05),
                custom(sqrt(sq(x - lsx) + sq(y - lsy) + sq(z - lsz)) - 0.04)
            ),
            custom(sqrt(sq(x - ex) + sq(y - ey) + sq(z - ez)) - 0.02)
        ),
        union(
            custom(segment_distance(x, y, z, asx, asy, asz, lsx, lsy, lsz) - 0.008),
            custom(sin(x*2.0) * sin(z*2.0) * 0.05)
        )
    );
}

// --- Catálisis Covalente (Intermedio) ---
def "covalent_catalysis_visualization"(ex, ey, ez, sx, sy, sz, ix, iy, iz, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x - ex) + sq(y - ey) + sq(z - ez)) - 0.04),
                custom(sqrt(sq(x - sx) + sq(y - sy) + sq(z - sz)) - 0.03)
            ),
            custom(sqrt(sq(x - ix) + sq(y - iy) + sq(z - iz)) - 0.035)
        ),
        union(
            union(
                custom(segment_distance(x, y, z, ex, ey, ez, ix, iy, iz) - 0.01),
                custom(segment_distance(x, y, z, sx, sy, sz, ix, iy, iz) - 0.005)
            ),
            custom(sqrt(sq(x - (ex + sx)*0.5) + sq(y - (ey + sy)*0.5) + sq(z - (ez + sz)*0.5)) - 0.02)
        )
    );
}

// --- Promiscuidad Catalítica ---
// 2 sustratos secundarios escalados por su actividad relativa
def "catalytic_promiscuity_visualization"(asx, asy, asz, s1x, s1y, s1z, s2x, s2y, s2z, a1, a2, intensity_threshold) {
    sdf: union(
        custom(sqrt(sq(x - asx) + sq(y - asy) + sq(z - asz)) - 0.06),
        union(
            union(
                custom(sqrt(sq(x - s1x) + sq(y - s1y) + sq(z - s1z)) - 0.025*(a1/(a1 + a2 + 1e-6))),
                custom(sqrt(sq(x - s2x) + sq(y - s2y) + sq(z - s2z)) - 0.025*(a2/(a1 + a2 + 1e-6)))
            ),
            union(
                union(
                    custom(segment_distance(x, y, z, asx, asy, asz, s1x, s1y, s1z) - 0.005*(a1/(a1 + a2 + 1e-6))),
                    custom(segment_distance(x, y, z, asx, asy, asz, s2x, s2y, s2z) - 0.005*(a2/(a1 + a2 + 1e-6)))
                ),
                custom(sqrt(sq(x - asx) + sq(y - asy) + sq(z - asz)) - 0.15*(max(a1, a2) - min(a1, a2)))
            )
        )
    );
}

