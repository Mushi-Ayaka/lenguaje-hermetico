// CINÉTICA QUÍMICA Y TERMODINÁMICA QUÍMICA: Estudio de velocidades de reacción,
// mecanismos, teorías de velocidad de reacción, acoplamiento cinética-termodinámica

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES FUNDAMENTALES
// ============================================================

let BOLTZMANN_KINETICS = 1.380649e-23;        // k_B (J/K)
let BOLTZMANN_EV_KINETICS = 8.617333262e-5;   // k_B (eV/K)
let GAS_CONSTANT_KINETICS = 8.314462618;      // R = N_A·k_B (J/(mol·K))
let AVOGADRO_KINETICS = 6.02214076e23;        // N_A (mol⁻¹)
let PLANCK_KINETICS = 6.62607015e-34;         // h (J·s)

// ============================================================
// INTERFAZ PÚBLICA - TEORÍAS DE VELOCIDAD DE REACCIÓN (fn)
// ============================================================

// --- Teoría de Colisiones (Simple) ---
// k = P·Z·exp(-E_a/(RT))
fn "collision_theory_rate"(collision_frequency, steric_factor, activation_energy, temperature) {
    collision_frequency * steric_factor * exp(-activation_energy / (GAS_CONSTANT_KINETICS * temperature))
}

// --- Frecuencia de Colisiones (Teoría de Colisiones) ---
// Z_AB = σ_AB·√(8kT/(πμ))·N_A·[A][B]
fn "collision_frequency_theory"(sigma_cs, reduced_mass, concentrationA, concentrationB, temperature) {
    sigma_cs * sqrt(8.0 * BOLTZMANN_KINETICS * temperature / (pi * reduced_mass + 1e-6)) * AVOGADRO_KINETICS * concentrationA * concentrationB
}

// --- Teoría del Estado de Transición (TST) ---
// k_TST = (k_BT/h)·K‡·exp(-ΔG‡/(RT))
fn "transition_state_theory_rate"(temperature, equilibrium_constant_ts, activation_free_energy) {
    (BOLTZMANN_KINETICS * temperature / PLANCK_KINETICS) * 
    equilibrium_constant_ts * exp(-activation_free_energy / (GAS_CONSTANT_KINETICS * temperature))
}

// --- Constante de Equilibrio del Estado de Transición ---
// K‡ = q‡/(q_A·q_B)·exp(-ΔE₀/(RT)) — 2 reactantes desplegados
fn "transition_state_equilibrium_constant"(partition_function_ts, partition_reactant1, partition_reactant2, zero_point_energy) {
    let q_ratio = partition_function_ts / ((partition_reactant1 + 1e-6) * (partition_reactant2 + 1e-6));
    q_ratio * exp(-zero_point_energy / (BOLTZMANN_KINETICS * 300.0))
}

// --- Teoría RRKM (Rice-Ramsperger-Kassel-Marcus) ---
// k(E) = Σ_P(E - E₀)/[h·ρ(E)] — densidad y suma evaluadas por el llamador
fn "rrkm_rate_constant"(energy, threshold_energy, density_of_states, sum_of_states) {
    sum_of_states / (PLANCK_KINETICS * density_of_states + 1e-6)
}

// --- Teoría de Marcus (Transferencia de Electrones) ---
// k_ET = (2π/h)·|V|²·(1/√(4πλk_BT))·exp(-(ΔG°+λ)²/(4λk_BT))
fn "marcus_electron_transfer_rate"(coupling_matrix_element, reorganization_energy, free_energy_change, temperature) {
    let prefactor = 2.0 * pi * coupling_matrix_element * coupling_matrix_element / PLANCK_KINETICS;
    let exponent = -(free_energy_change + reorganization_energy) * 
                   (free_energy_change + reorganization_energy) / 
                   (4.0 * reorganization_energy * BOLTZMANN_KINETICS * temperature + 1e-6);
    let normalization = 1.0 / sqrt(4.0 * pi * reorganization_energy * BOLTZMANN_KINETICS * temperature);
    
    prefactor * normalization * exp(exponent)
}

// ============================================================
// INTERFAZ PÚBLICA - CINÉTICA DE REACCIONES COMPLEJAS (fn)
// ============================================================

// --- Mecanismo Consecutivo (A → B → C) ---
fn "consecutive_reaction_kinetics"(initial_A, k1, k2, time) {
    let A = initial_A * exp(-k1 * time);
    let B = (k1 * initial_A / (k2 - k1 + 1e-6)) * (exp(-k1 * time) - exp(-k2 * time));
    let C = initial_A - A - B;
    [A, B, C]
}

// --- Mecanismo Paralelo (Competitivo) ---
fn "parallel_reaction_kinetics"(initial_A, k1, k2, time) {
    let A = initial_A * exp(-(k1 + k2) * time);
    let B = (k1 * initial_A / (k1 + k2)) * (1.0 - exp(-(k1 + k2) * time));
    let C = (k2 * initial_A / (k1 + k2)) * (1.0 - exp(-(k1 + k2) * time));
    [A, B, C]
}

// --- Mecanismo Reversible (A ⇌ B) ---
fn "reversible_reaction_kinetics"(initial_A, initial_B, k_forward, k_reverse, time) {
    let k_sum = k_forward + k_reverse;
    let equilibrium_A = (k_reverse * (initial_A + initial_B)) / k_sum;
    let deviation = initial_A - equilibrium_A;
    
    let A = equilibrium_A + deviation * exp(-k_sum * time);
    let B = (initial_A + initial_B) - A;
    [A, B]
}

// --- Mecanismo en Cadena (Radicales) ---
fn "chain_reaction_kinetics"(initiation_rate, propagation_rate, termination_rate, time) {
    let chain_length = propagation_rate / sqrt(initiation_rate * termination_rate + 1e-6);
    let radical_concentration = sqrt(initiation_rate / termination_rate) * 
                                (1.0 - exp(-propagation_rate * time));
    [chain_length, radical_concentration]
}

// --- Cinética Autocatalítica ---
// A + B → 2B
fn "autocatalytic_kinetics"(initial_A, initial_B, rate_constant, time) {
    let total = initial_A + initial_B;
    let ratio = initial_B / (initial_A + 1e-6);
    let B = total / (1.0 + (1.0/ratio) * exp(-rate_constant * total * time));
    let A = total - B;
    [A, B]
}

// ============================================================
// INTERFAZ PÚBLICA - CINÉTICA ENZIMÁTICA AVANZADA (fn)
// ============================================================

// --- Ecuación de Michaelis-Menten con Inhibición ---
// inhibition_type: 0=competitiva, 1=no competitiva, 2=acompetitiva, 3=sin inhibición
fn "michaelis_menten_with_inhibition"(substrate, inhibitor, vmax, km, ki, inhibition_type) {
    let is_competitive = 1.0 - step(0.5, inhibition_type);
    let is_noncompetitive = step(0.5, inhibition_type) * (1.0 - step(1.5, inhibition_type));
    let is_uncompetitive = step(1.5, inhibition_type) * (1.0 - step(2.5, inhibition_type));
    let is_none = step(2.5, inhibition_type);
    
    let v_competitive = vmax * substrate / (km * (1.0 + inhibitor/(ki + 1e-6)) + substrate);
    let v_noncompetitive = (vmax / (1.0 + inhibitor/(ki + 1e-6))) * substrate / (km + substrate);
    let v_uncompetitive = vmax * substrate / (km + substrate * (1.0 + inhibitor/(ki + 1e-6)));
    let v_none = vmax * substrate / (km + substrate);
    
    is_competitive * v_competitive + is_noncompetitive * v_noncompetitive + 
    is_uncompetitive * v_uncompetitive + is_none * v_none
}

// --- Cinética de Cooperatividad (Hill) ---
// v = V_max·[S]^n/(K^n + [S]^n)
fn "hill_equation_cooperativity"(substrate, vmax, hill_coefficient, dissociation_constant) {
    vmax * pow(substrate, hill_coefficient) / 
    (pow(dissociation_constant, hill_coefficient) + pow(substrate, hill_coefficient))
}

// --- Coeficiente de Hill (Medida de Cooperatividad) ---
// n_H a partir de 2 puntos (substrato, velocidad) y v_max
fn "hill_coefficient_from_data"(substrate1, substrate2, velocity1, velocity2, v_max) {
    let ratio1 = velocity1 / (v_max - velocity1 + 1e-6);
    let ratio2 = velocity2 / (v_max - velocity2 + 1e-6);
    
    log(ratio2 / (ratio1 + 1e-6)) / (log(substrate2 / (substrate1 + 1e-6)) + 1e-6)
}

// --- Cinética de Múltiples Sustratos (Ordenado vs Aleatorio) ---
// mechanism_type: 0=ordered, 1=random, 2=ping-pong
fn "multi_substrate_kinetics"(substrateA, substrateB, vmax, kmA, kmB, kiA, mechanism_type) {
    let is_ordered = 1.0 - step(0.5, mechanism_type);
    let is_random = step(0.5, mechanism_type) * (1.0 - step(1.5, mechanism_type));
    let is_pingpong = step(1.5, mechanism_type);
    
    let v_ordered = vmax * substrateA * substrateB / 
                    (kmA * kmB + kmB * substrateA + substrateA * substrateB + 1e-6);
    let v_random = vmax * substrateA * substrateB / 
                   ((kmA + substrateA) * (kmB + substrateB));
    let v_pingpong = vmax * substrateA * substrateB / 
                     (kmB * substrateA + kmA * substrateB + substrateA * substrateB + 1e-6);
    
    is_ordered * v_ordered + is_random * v_random + is_pingpong * v_pingpong
}

// ============================================================
// INTERFAZ PÚBLICA - TERMODINÁMICA DE NO EQUILIBRIO (fn)
// ============================================================

// --- Relación de Onsager (Reciprocidad) ---
// J_i = Σ_j L_ij·X_j, con L_ij = L_ji — sistema 2×2
fn "onsager_relations"(force1, force2, L11, L12, L21, L22) {
    [L11 * force1 + L12 * force2, L21 * force1 + L22 * force2]
}

// --- Producción de Entropía (Irreversible) ---
// σ = Σ_i J_i·X_i ≥ 0 — 2 pares flujo-fuerza
fn "entropy_production_rate"(flux1, flux2, force1, force2) {
    max(0.0, flux1 * force1 + flux2 * force2)  // Siempre positiva o cero
}

// --- Teorema de Fluctuación-Disipación ---
// ⟨δJ_i(t)·δJ_j(0)⟩ = 2k_BT·L_ij·δ(t)
fn "fluctuation_dissipation_relation"(temperature, phenomenological_coefficient, delta_time) {
    2.0 * BOLTZMANN_KINETICS * temperature * phenomenological_coefficient * exp(-delta_time*delta_time/0.1)
}

// --- Teoría de Respuesta Lineal ---
// ⟨δA(t)⟩ = ∫_0^t Φ_AB(t-t')·δF_B(t') dt'
fn "linear_response_function"(susceptibility, external_perturbation, time) {
    // Integral de convolución simplificada
    susceptibility * external_perturbation * (1.0 - exp(-time/0.1))
}

// ============================================================
// INTERFAZ PÚBLICA - OSCILACIONES Y PATRONES (fn)
// ============================================================

// --- Ecuaciones de Lotka-Volterra (Depredador-Presa) ---
fn "lotka_volterra_equations"(prey_population, predator_population, alpha_lv, beta, gamma, delta, time_step) {
    // dx/dt = αx - βxy
    // dy/dt = δxy - γy
    let prey_change = alpha_lv * prey_population - beta * prey_population * predator_population;
    let predator_change = delta * prey_population * predator_population - gamma * predator_population;
    
    [prey_population + prey_change * time_step, 
     predator_population + predator_change * time_step]
}

// --- Modelo de Brusselator (Reacción-Difusión) ---
fn "brusselator_reaction_diffusion"(concentrationA, concentrationB, k1, k2, k3, k4, Dx, Dy, spatial_position) {
    // A → X, B + X → Y + D, 2X + Y → 3X, X → E
    let production_x = k1 * concentrationA - k2 * concentrationB * concentrationA + 
                      k3 * concentrationA * concentrationA * concentrationB - k4 * concentrationA;
    let production_y = k2 * concentrationB * concentrationA - k3 * concentrationA * concentrationA * concentrationB;
    
    let diffusion_x = Dx * (sin(spatial_position*5.0) * 0.1);  // Simplificado
    let diffusion_y = Dy * (cos(spatial_position*5.0) * 0.1);
    
    [production_x + diffusion_x, production_y + diffusion_y]
}

// --- Condición de Turing (Inestabilidad) ---
// Para sistema 2×2: D_y/D_x > |J_22|/J_11 — devuelve 1 si se cumple
fn "turing_instability_condition"(diffusion_ratio, J11, J22) {
    step(abs(J22) / (J11 + 1e-6), diffusion_ratio)
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs DE CINÉTICA QUÍMICA (def)
// ============================================================

// --- Superficie de Energía Potencial de Reacción ---
// Perfil continuo por tramos (reactivos/TS/productos); el tramo central es la
// parábola por (0.3, e_A), (0.45, ts_barrier), (0.6, e_B) → sin saltos
def "reaction_potential_energy_surface"(reactant_energy, ts_barrier, product_energy, intensity_threshold) {
    sdf: union(
        custom(y - (1.0 - step(0.3, abs(x))) * (abs(x)*abs(x) * reactant_energy)
                - step(0.3, abs(x)) * (1.0 - step(0.6, abs(x))) * (ts_barrier 
                    + ((0.09*reactant_energy + 0.0225*product_energy - 2.0*ts_barrier)/0.045) * (abs(x) - 0.45)*(abs(x) - 0.45)
                    + ((0.0225*product_energy - 0.09*reactant_energy)/0.3) * (abs(x) - 0.45))
                - step(0.6, abs(x)) * ((abs(x) - 0.75)*(abs(x) - 0.75) * product_energy)
                - intensity_threshold),
        custom(segment_distance(x, y, z, -0.4, 0.05, 0.0, 0.4, 0.05, 0.0) - 0.02)
    );
}

// --- Teoría de Colisiones Moleculares ---
def "molecular_collision_theory_visualization"(collision_sigma_cs, relative_velocity, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x + 0.3) + y*y + z*z) - 0.05),
                custom(sqrt(sq(x - 0.3) + y*y + z*z) - 0.05)
            ),
            union(
                custom(segment_distance(x, y, z, -0.4, 0.0, 0.0, -0.3, 0.0, 0.0) - 0.01),
                custom(segment_distance(x, y, z, 0.4, 0.0, 0.0, 0.3, 0.0, 0.0) - 0.01)
            )
        ),
        union(
            custom(max(abs(y) - 0.005, sqrt(x*x + z*z) - sqrt(collision_sigma_cs/pi)*0.3)),
            custom(y - 0.5 * relative_velocity * relative_velocity * 0.1 - intensity_threshold)
        )
    );
}

// --- Estado de Transición (Complejo Activado) ---
def "transition_state_complex_visualization"(ts_height, reactant_radius, product_radius, ts_radius, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(sqrt(sq(x + 0.4) + y*y + z*z) - reactant_radius),
                custom(sqrt(x*x + sq(y - ts_height) + z*z) - ts_radius)
            ),
            custom(sqrt(sq(x - 0.4) + y*y + z*z) - product_radius)
        ),
        union(
            custom(segment_distance(x, y, z, -0.4, 0.0, 0.0, 0.4, 0.0, 0.0) - 0.015),
            custom(segment_distance(x, y, z, 0.0, 0.0, 0.0, 0.0, ts_height, 0.0) - 0.02)
        )
    );
}

// --- Cinética Enzimática Michaelis-Menten ---
// S = |x|·substrate_scale; curva v(S) y complejo ES escalado por saturación
def "michaelis_menten_kinetics_visualization"(substrate_scale, vmax, km, intensity_threshold) {
    sdf: union(
        sphere(0.08),
        union(
            custom(y - (vmax * abs(x)*substrate_scale / (km + abs(x)*substrate_scale + 1e-6)) * 0.1 - intensity_threshold),
            union(
                custom(exp(-(x*x + z*z)/0.03) * (abs(x)*substrate_scale/(km + abs(x)*substrate_scale + 1e-6)) - intensity_threshold * 0.5),
                custom(sqrt(x*x + sq(y - 0.05) + z*z) - 0.06 * (abs(x)*substrate_scale/(km + abs(x)*substrate_scale + 1e-6)))
            )
        )
    );
}

// --- Oscilaciones Químicas (Sistema Belousov-Zhabotinsky) ---
def "chemical_oscillations_bz_pattern"(time, wave_number, intensity_threshold) {
    sdf: custom(y 
        - sin(x*wave_number + time) * sin(z*wave_number + time*1.5) * 0.4
        - sin(sqrt(x*x + z*z) * wave_number*1.5 - atan(z, x) - time*3.0) * 0.3
        - step(0.0, sin(x*3.0 - time*2.0)) * 0.2
        - intensity_threshold);
}

// --- Difusión con Reacción (Sistema de Reacción-Difusión) ---
def "reaction_diffusion_system"(diffusion_coefficient, reaction_rate, time, intensity_threshold) {
    sdf: custom(y 
        - diffusion_coefficient * (sin(x*5.0) + sin(z*5.0)) * 0.1
        - reaction_rate * sqrt(x*x + z*z) * (1.0 - sqrt(x*x + z*z)) * sin(time * 2.0)
        - intensity_threshold);
}

// ============================================================
// INTERFAZ PÚBLICA - FENÓMENOS AVANZADOS (def)
// ============================================================

// --- Catálisis Heterogénea (Superficie) ---
// Superficie y=0; sitios adsorbidos como nódulos periódicos en anillos
def "heterogeneous_catalysis_surface"(surface_sites, adsorption_rate, reaction_rate, intensity_threshold) {
    sdf: union(
        custom(y),
        union(
            custom(max(abs(y - 0.02) - 0.03, abs(sqrt(x*x + z*z) - 0.25) - 0.02 - 0.012*cos(surface_sites*atan(z, x)))),
            union(
                custom(max(abs(y - 0.06) - 0.02*adsorption_rate, abs(sqrt(x*x + z*z) - 0.2) - 0.015 - 0.01*cos((surface_sites*0.5)*atan(z, x)))),
                custom(sqrt(x*x + sq(y - 0.15) + z*z) - 0.04*reaction_rate)
            )
        )
    );
}

// --- Cinética de Polimerización ---
// 5 cadenas desplegadas (i=0..4); longitud proporcional a propagación·monómero
def "polymerization_kinetics_visualization"(monomer_concentration, initiation_rate, propagation_rate, intensity_threshold) {
    sdf: union(
        union(
            union(
                custom(segment_distance(x, y, z, -0.3, 0.0, 0.0, -0.3, propagation_rate*monomer_concentration*1.0*0.1, 0.0) - 0.02),
                custom(segment_distance(x, y, z, -0.15, 0.0, 0.0, -0.15, propagation_rate*monomer_concentration*2.0*0.1, 0.0) - 0.02)
            ),
            union(
                custom(segment_distance(x, y, z, 0.0, 0.0, 0.0, 0.0, propagation_rate*monomer_concentration*3.0*0.1, 0.0) - 0.02),
                union(
                    custom(segment_distance(x, y, z, 0.15, 0.0, 0.0, 0.15, propagation_rate*monomer_concentration*4.0*0.1, 0.0) - 0.02),
                    custom(segment_distance(x, y, z, 0.3, 0.0, 0.0, 0.3, propagation_rate*monomer_concentration*5.0*0.1, 0.0) - 0.02)
                )
            )
        ),
        union(
            union(
                union(
                    custom(sqrt(sq(x + 0.3) + sq(y - propagation_rate*monomer_concentration*1.0*0.1 - 0.03) + z*z) - 0.015*monomer_concentration),
                    custom(sqrt(sq(x + 0.15) + sq(y - propagation_rate*monomer_concentration*2.0*0.1 - 0.03) + z*z) - 0.015*monomer_concentration)
                ),
                custom(sqrt(sq(x) + sq(y - propagation_rate*monomer_concentration*3.0*0.1 - 0.03) + z*z) - 0.015*monomer_concentration)
            ),
            union(
                union(
                    custom(sqrt(sq(x - 0.15) + sq(y - propagation_rate*monomer_concentration*4.0*0.1 - 0.03) + z*z) - 0.015*monomer_concentration),
                    custom(sqrt(sq(x - 0.3) + sq(y - propagation_rate*monomer_concentration*5.0*0.1 - 0.03) + z*z) - 0.015*monomer_concentration)
                ),
                custom(sqrt(sq(x + 0.4) + sq(y - 0.05) + z*z) - 0.03*initiation_rate)
            )
        )
    );
}

// --- Autoensamblaje Molecular (Micelas) ---
// Anillo de micelas (frecuencia ∝ exceso sobre CMC) + monómeros libres
def "molecular_self_assembly_micelles"(surfactant_concentration, critical_micelle_concentration, intensity_threshold) {
    sdf: union(
        custom(sqrt(x*x + sq(y - 0.1) + z*z) - 0.02*min(surfactant_concentration, critical_micelle_concentration)),
        custom(max(abs(y) - 0.07, abs(sqrt(x*x + z*z) - 0.3) - 0.02 - 0.015*cos(max(surfactant_concentration - critical_micelle_concentration, 0.0)*5.0*atan(z, x))))
    );
}

// --- Reloj Químico (Oscilaciones Temporales) ---
def "chemical_clock_temporal_oscillations"(time, oscillation_period, amplitude, intensity_threshold) {
    sdf: union(
        custom(sqrt(x*x + y*y + z*z) - (0.1 + amplitude * sin(2.0 * pi * time / oscillation_period) * 0.05)),
        custom(segment_distance(x, y, z, 0.0, 0.0, 0.0,
               0.15 * cos(2.0 * pi * time / oscillation_period),
               0.15 * sin(2.0 * pi * time / oscillation_period), 0.0) - 0.02)
    );
}

// --- Gradiente de Concentración en Reactor ---
def "concentration_gradient_reactor"(inlet_concentration, reaction_rate, diffusion_coefficient, intensity_threshold) {
    sdf: custom(y 
        - inlet_concentration * exp(-reaction_rate * x)
        - diffusion_coefficient * (1.0 - x) * 0.1
        - sin(z*3.0) * exp(-x*x/0.2) * 0.05
        - intensity_threshold);
}

