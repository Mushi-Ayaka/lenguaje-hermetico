// QUÍMICA CUÁNTICA: Aplicación de mecánica cuántica a sistemas químicos,
// estructura electrónica molecular, orbitales, enlaces químicos, reactividad

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES FUNDAMENTALES
// ============================================================

let BOLTZMANN_QUANTCHEM = 8.617333262e-5;      // k_B (eV/K)
let HARTREE_TO_EV = 27.211386245988;          // 1 Ha = 27.211 eV
let BOHR_TO_ANGSTROM = 0.529177210903;        // 1 a₀ = 0.529 Å
let EV_TO_HARTREE = 1.0 / HARTREE_TO_EV;
let ANGSTROM_TO_BOHR = 1.0 / BOHR_TO_ANGSTROM;

// ============================================================
// INTERFAZ PÚBLICA - ECUACIÓN DE SCHRÖDINGER MOLECULAR (fn)
// ============================================================

// --- Hamiltonian Electrónico (No relativista, 2e⁻ + 2 núcleos) ---
// Ĥ = T + V_en + V_ee + V_nn (unidades atómicas; T = 2 e⁻ × ½ = 1)
fn "molecular_hamiltonian"(e1x, e1y, e1z, e2x, e2y, e2z, 
                           n1x, n1y, n1z, z1, n2x, n2y, n2z, z2) {
    1.0
    - z1/(sqrt(sq(e1x - n1x) + sq(e1y - n1y) + sq(e1z - n1z)) + 1e-6)
    - z1/(sqrt(sq(e2x - n1x) + sq(e2y - n1y) + sq(e2z - n1z)) + 1e-6)
    - z2/(sqrt(sq(e1x - n2x) + sq(e1y - n2y) + sq(e1z - n2z)) + 1e-6)
    - z2/(sqrt(sq(e2x - n2x) + sq(e2y - n2y) + sq(e2z - n2z)) + 1e-6)
    + 1.0/(sqrt(sq(e1x - e2x) + sq(e1y - e2y) + sq(e1z - e2z)) + 1e-6)
    + z1*z2/(sqrt(sq(n1x - n2x) + sq(n1y - n2y) + sq(n1z - n2z)) + 1e-6)
}

// --- Aproximación de Born-Oppenheimer ---
// Separa movimiento electrónico (rápido) de nuclear (lento)
fn "born_oppenheimer_energy"(electronic_energy, nuclear_repulsion) {
    electronic_energy + nuclear_repulsion
}

// --- Superficie de Energía Potencial (PES, armónica) ---
// E(R) ≈ ½·k·(R - R_eq)²
fn "potential_energy_surface"(equilibrium_distance, force_constant, bond_distance) {
    0.5 * force_constant * (bond_distance - equilibrium_distance) * (bond_distance - equilibrium_distance)
}

// ============================================================
// INTERFAZ PÚBLICA - TEORÍA DE ORBITALES MOLECULARES (fn)
// ============================================================

// --- Orbital Molecular como Combinación Lineal de Orbitales Atómicos (LCAO) ---
// ψ(r) = c₁·φ₁(r) + c₂·φ₂(r), con φ gaussianas 1s en cada centro
fn "molecular_orbital_lcao"(coefficient1, coefficient2, 
                            atom1_x, atom1_y, atom1_z, atom2_x, atom2_y, atom2_z,
                            orbital_exponent, point_x, point_y, point_z) {
    coefficient1 * exp(-orbital_exponent * (sq(point_x - atom1_x) + sq(point_y - atom1_y) + sq(point_z - atom1_z))) +
    coefficient2 * exp(-orbital_exponent * (sq(point_x - atom2_x) + sq(point_y - atom2_y) + sq(point_z - atom2_z)))
}

// --- Integral de Solapamiento (Overlap, gaussianas 1s) ---
// S = (π/2α)^{3/2}·exp(-αR²/2)
fn "overlap_integral"(orbital_exponent, distance_between_centers) {
    pow(pi / (2.0 * orbital_exponent), 1.5) * 
    exp(-orbital_exponent * distance_between_centers * distance_between_centers / 2.0)
}

// --- Integral de Resonancia (Aproximación de Wolfsberg-Helmholtz) ---
// H_μν ≈ K·S_μν·(H_μμ + H_νν)/2
fn "hamiltonian_matrix_element"(overlap, diagonal_element_mu, diagonal_element_nu, k_factor) {
    k_factor * overlap * (diagonal_element_mu + diagonal_element_nu) / 2.0
}

// --- Ecuaciones de Hartree-Fock (Roothaan-Hall, diagonal 2×2) ---
// FC = SCε → ε_i ≈ F_ii/S_ii
fn "roothaan_hall_equations"(f11, s11, f22, s22) {
    [f11 / (s11 + 1e-6), f22 / (s22 + 1e-6)]
}

// ============================================================
// INTERFAZ PÚBLICA - FUNCIONES DE ONDA Y DENSIDAD (fn)
// ============================================================

// --- Densidad Electrónica ---
// ρ(r) = Σ_i n_i·|φ_i(r)|², con φ gaussianas 1s en cada centro
fn "electron_density"(occupation1, occupation2,
                      atom1_x, atom1_y, atom1_z, atom2_x, atom2_y, atom2_z,
                      orbital_exponent, point_x, point_y, point_z) {
    occupation1 * exp(-2.0 * orbital_exponent * (sq(point_x - atom1_x) + sq(point_y - atom1_y) + sq(point_z - atom1_z))) +
    occupation2 * exp(-2.0 * orbital_exponent * (sq(point_x - atom2_x) + sq(point_y - atom2_y) + sq(point_z - atom2_z)))
}

// --- Densidad de Carga de Fase ---
// Diferencia entre densidad molecular y suma de densidades atómicas (2 átomos)
fn "charge_density_difference"(molecular_density, atomic_density1, atomic_density2) {
    molecular_density - (atomic_density1 + atomic_density2)
}

// --- Función de Onda de Slater (Determinante 2×2) ---
// Ψ = (1/√N!)·det[ψ_i(x_j)] → det = ψ₁(x₁)ψ₂(x₂) - ψ₁(x₂)ψ₂(x₁)
fn "slater_determinant"(psi1_at_e1, psi2_at_e1, psi1_at_e2, psi2_at_e2, normalization) {
    (psi1_at_e1 * psi2_at_e2 - psi1_at_e2 * psi2_at_e1) / (normalization + 1e-6)
}

// --- Factor de Configuración (CI Coefficients) ---
// ⟨Ψ_I|Ĥ|Ψ_J⟩ → c_J·H_IJ
fn "configuration_interaction_coefficient"(determinant_amplitude, hamiltonian_coupling) {
    determinant_amplitude * hamiltonian_coupling
}

// ============================================================
// INTERFAZ PÚBLICA - TEORÍA DEL FUNCIONAL DE LA DENSIDAD (DFT) (fn)
// ============================================================

// --- Energía Total DFT (Kohn-Sham, funcionales lineales en ρ) ---
// E[ρ] ≈ ρ·(T' + V'_ext + J' + E'_xc)
fn "dft_total_energy"(density_value, kinetic_factor, external_factor, hartree_factor, xc_factor) {
    density_value * (kinetic_factor + external_factor + hartree_factor + xc_factor)
}

// --- Energía de Hartree (Coulomb clásico, aproximación local) ---
// J[ρ] ≈ ½·ρ²
fn "hartree_energy"(density_value) {
    0.5 * density_value * density_value
}

// --- Funcional de Intercambio-Correlación LDA ---
// ε_xc ≈ -0.7386·ρ^(1/3) (intercambio de Dirac)
fn "lda_exchange_correlation_energy"(density_value) {
    -0.7386 * pow(density_value, 1.0/3.0)
}

// --- Potencial de Kohn-Sham ---
// v_KS(r) = v_ext(r) + v_H(r) + v_xc(r)
fn "kohn_sham_potential"(external_potential, hartree_potential, exchange_correlation_potential) {
    external_potential + hartree_potential + exchange_correlation_potential
}

// --- Brecha de Energía de Kohn-Sham ---
// Δ_KS = ε_LUMO - ε_HOMO
fn "kohn_sham_band_gap"(homo_energy, lumo_energy) {
    lumo_energy - homo_energy
}

// ============================================================
// INTERFAZ PÚBLICA - ENLACES QUÍMICOS Y REACTIVIDAD (fn)
// ============================================================

// --- Teoría de Orbitales Frontera (Fukui) ---
// f(r) = ρ_N+1(r) - ρ_N(r) ≈ |ψ_LUMO(r)|²
fn "fukui_function"(lumo_density) {
    // Función de Fukui: reactividad local
    lumo_density
}

// --- Índice de Reactividad (Hardness/Softness) ---
// η = (IP - EA)/2, S = 1/(2η)
fn "chemical_hardness"(ionization_potential, electron_affinity) {
    (ionization_potential - electron_affinity) / 2.0
}

fn "chemical_softness"(hardness) {
    1.0 / (2.0 * hardness + 1e-6)
}

// --- Potencial Químico (DFT) ---
// μ = -χ = (IP + EA)/2
fn "chemical_potential_dft"(ionization_potential, electron_affinity) {
    -(ionization_potential + electron_affinity) / 2.0
}

// --- Descriptores de Reactividad Global ---
fn "electrophilicity_index"(chemical_potential, hardness) {
    chemical_potential * chemical_potential / (2.0 * hardness + 1e-6)
}

// --- Teoría del Estado de Transición (TST) Cuántica ---
fn "quantum_transition_state_rate"(barrier_height, temperature, frequency_factor) {
    // k = ν·exp(-ΔE‡/(k_BT))
    let kT = BOLTZMANN_QUANTCHEM * temperature;
    frequency_factor * exp(-barrier_height / kT)
}

// ============================================================
// INTERFAZ PÚBLICA - MÉTODOS POST-HARTREE-FOCK (fn)
// ============================================================

// --- Energía de Correlación MP2 (Møller-Plesset 2º orden, 2×2) ---
// E_corr = Σ_ia |⟨ij||ab⟩|²/(ε_i + ε_j - ε_a - ε_b)
fn "mp2_correlation_energy"(integral_11, integral_12, integral_21, integral_22,
                            occ_energy1, occ_energy2, virt_energy1, virt_energy2) {
    integral_11 * integral_11 / (2.0*occ_energy1 - 2.0*virt_energy1 + 1e-6) +
    integral_12 * integral_12 / (2.0*occ_energy1 - 2.0*virt_energy2 + 1e-6) +
    integral_21 * integral_21 / (2.0*occ_energy2 - 2.0*virt_energy1 + 1e-6) +
    integral_22 * integral_22 / (2.0*occ_energy2 - 2.0*virt_energy2 + 1e-6)
}

// --- Energía de Configuración Interacción (CISD, 2 excitaciones) ---
// E_CISD = E_ref + Σ_i c_i·⟨Ψ_0|Ĥ|Ψ_i⟩
fn "cisd_energy"(reference_energy, coefficient1, matrix_element1, coefficient2, matrix_element2) {
    reference_energy + coefficient1 * matrix_element1 + coefficient2 * matrix_element2
}

// --- Energía Coupled-Cluster (CCSD, 2 amplitudes T₁ y 2 T₂) ---
// Ψ_CC = exp(T)|Ψ_0⟩, T = T₁ + T₂
fn "coupled_cluster_energy"(reference_energy, t1_amplitude_a, t1_amplitude_b, 
                            t2_amplitude_a, t2_amplitude_b) {
    reference_energy + 
    (t1_amplitude_a*t1_amplitude_a + t1_amplitude_b*t1_amplitude_b) * 0.1 +
    (t2_amplitude_a*t2_amplitude_a + t2_amplitude_b*t2_amplitude_b) * 0.2
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs DE QUÍMICA CUÁNTICA (def)
// ============================================================

// --- Orbitales Moleculares Visualizados ---
// 2 orbitales LCAO sobre 2 centros (±d/2 en x): contornos |ψ| = th
def "molecular_orbitals_visualization"(coefficient_11, coefficient_12, coefficient_21, coefficient_22,
                                       atom_separation, intensity_threshold) {
    sdf: union(
        custom(abs(coefficient_11 * exp(-(sq(x + atom_separation*0.5) + y*y + z*z)/0.1)
                 + coefficient_12 * exp(-(sq(x - atom_separation*0.5) + y*y + z*z)/0.1)) 
               - intensity_threshold),
        custom(abs(coefficient_21 * exp(-(sq(x + atom_separation*0.5) + y*y + z*z)/0.1)
                 + coefficient_22 * exp(-(sq(x - atom_separation*0.5) + y*y + z*z)/0.1)) 
               - intensity_threshold*0.8)
    );
}

// --- Densidad Electrónica Molecular ---
// Suma de densidades gaussianas (2 núcleos) + patrón de enlace
def "molecular_electron_density"(nucleus1_x, nucleus1_y, nucleus1_z, charge1,
                                 nucleus2_x, nucleus2_y, nucleus2_z, charge2,
                                 intensity_threshold) {
    sdf: custom(
        charge1 * exp(-(sq(x - nucleus1_x) + sq(y - nucleus1_y) + sq(z - nucleus1_z))/0.05)
        + charge2 * exp(-(sq(x - nucleus2_x) + sq(y - nucleus2_y) + sq(z - nucleus2_z))/0.05)
        + sin(x*3.0) * cos(z*3.0) * 0.1
        - intensity_threshold);
}

// --- Superficie de Energía Potencial (PES) ---
// Perfil radial continuo: parábola por (0.3; 0.09·E_r), (0.45; E_ts), (0.6; 0.04·E_p)
def "potential_energy_surface_visualization"(reactant_energy, ts_energy, product_energy, intensity_threshold) {
    sdf: custom(y 
        - (1.0 - step(0.3, sqrt(x*x + z*z))) * (x*x + z*z) * reactant_energy
        - step(0.3, sqrt(x*x + z*z)) * (1.0 - step(0.6, sqrt(x*x + z*z))) * (ts_energy 
            + ((0.09*reactant_energy + 0.04*product_energy - 2.0*ts_energy)/0.045) * (sqrt(x*x + z*z) - 0.45)*(sqrt(x*x + z*z) - 0.45)
            + ((0.04*product_energy - 0.09*reactant_energy)/0.3) * (sqrt(x*x + z*z) - 0.45))
        - step(0.6, sqrt(x*x + z*z)) * (sqrt(x*x + z*z) - 0.8)*(sqrt(x*x + z*z) - 0.8) * product_energy
        - intensity_threshold);
}

// --- Orbitales Frontera (HOMO-LUMO) ---
// HOMO enlazante (g₁+g₂) y LUMO antienlazante (g₁-g₂) sobre 2 centros
def "frontier_orbitals_visualization"(orbital_exponent, atom_separation, intensity_threshold) {
    sdf: union(
        custom(abs(exp(-orbital_exponent*(sq(x + atom_separation*0.5) + y*y + z*z)) 
                 + exp(-orbital_exponent*(sq(x - atom_separation*0.5) + y*y + z*z))) 
               - intensity_threshold),
        custom(abs(exp(-orbital_exponent*(sq(x + atom_separation*0.5) + y*y + z*z)) 
                 - exp(-orbital_exponent*(sq(x - atom_separation*0.5) + y*y + z*z))) 
               - intensity_threshold*0.8)
    );
}

// --- Enlace Químico (Densidad de Enlace) ---
// Máximo en el punto medio de un enlace alineado en x (±d/2)
def "chemical_bond_density"(bond_length, bond_order, intensity_threshold) {
    sdf: custom(
        exp(-(x*x + y*y + z*z)/0.02) 
        * exp(-(x + bond_length*0.5)*(x + bond_length*0.5)/0.1) 
        * bond_order 
        - intensity_threshold);
}

// --- Correlación Electrónica (Agujero de Correlación) ---
// ρ_corr - ρ_ref² + pozo negativo centrado en el origen
def "electron_correlation_hole"(reference_density, correlated_density, intensity_threshold) {
    sdf: custom(correlated_density - reference_density * reference_density 
                - exp(-(x*x + y*y + z*z)/0.05) * 0.2 
                - intensity_threshold);
}

// --- Excited States (Absorción Óptica) ---
// 3 transiciones lorentzianas en el eje y (energía)
def "excited_states_absorption"(ground_state, excited_state1, excited_state2, excited_state3,
                                dipole1, dipole2, dipole3, intensity_threshold) {
    sdf: custom(
        dipole1*dipole1*(excited_state1 - ground_state)/(sq(y - (excited_state1 - ground_state)) + 0.01)
        + dipole2*dipole2*(excited_state2 - ground_state)/(sq(y - (excited_state2 - ground_state)) + 0.01)
        + dipole3*dipole3*(excited_state3 - ground_state)/(sq(y - (excited_state3 - ground_state)) + 0.01)
        - intensity_threshold);
}

// --- Transferencia de Carga (CT States) ---
def "charge_transfer_states"(donor_density, acceptor_density, coupling, intensity_threshold) {
    sdf: custom(sin(x*2.0) * (donor_density - acceptor_density) * coupling - intensity_threshold);
}

// --- Vibraciones Moleculares (Modos normales) ---
// 2 átomos oscilando + superposición de 3 modos normales temporales
def "molecular_vibrations_normal_modes"(atom_separation, frequency1, frequency2, frequency3, intensity_threshold) {
    sdf: union(
        union(
            custom(sqrt(sq(x + atom_separation*0.5) + y*y + z*z) - 0.05),
            custom(sqrt(sq(x - atom_separation*0.5) + y*y + z*z) - 0.05)
        ),
        custom(sin(x*3.0) * cos(z*3.0) * sin(frequency1 * w) * 0.1
               + sin(x*3.0 + 1.0) * cos(z*3.0) * sin(frequency2 * w) * 0.1
               + sin(x*3.0 + 2.0) * cos(z*3.0) * sin(frequency3 * w) * 0.1
               - intensity_threshold)
    );
}

// --- Efecto Jahn-Teller (Distorsión) ---
// Estado degenerado que se separa en 2 lóbulos al distorsionar
def "jahn_teller_distortion"(distortion_strength) {
    sdf: union(
        custom(sqrt(x*x + y*y + sq(z - distortion_strength*0.3)) - 0.1),
        custom(sqrt(x*x + y*y + sq(z + distortion_strength*0.3)) - 0.1)
    );
}

// --- Efecto de Solvente (Polarización) ---
def "solvent_polarization_effect"(solute_density, dielectric_constant, intensity_threshold) {
    sdf: union(
        sphere(0.3),
        custom((1.0 - 1.0/(dielectric_constant + 1e-6)) * solute_density / (x*x + y*y + z*z + 1e-6)
               - intensity_threshold)
    );
}

// ============================================================
// EJEMPLOS DE USO CON custom(expr)
