// ESPECTROSCOPIA MOLECULAR: Transiciones rotacionales, vibracionales, electrónicas,
// espectros de absorción/emisión, reglas de selección, constantes espectroscópicas

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// CONSTANTES ESPECTROSCÓPICAS
// ============================================================

// Constante de rotación (para molécula diatómica)
let ROTATIONAL_CONSTANT_BASE = 10.0;        // B₀ escalado (cm⁻¹)
let CENTRIFUGAL_DISTORTION_CONSTANT = 0.001; // D escalado

// Constantes vibracionales
let HARMONIC_FREQUENCY_BASE = 1000.0;       // ωₑ escalado (cm⁻¹)
let ANHARMONICITY_CONSTANT = 0.01;          // ωₑχₑ escalado

// Constantes de acoplamiento
let VIBRATION_ROTATION_CONSTANT = 0.1;      // αₑ escalado

// Constantes de espectros atómicos (extensiones)
let RYDBERG_CONSTANT = 109737.0;            // R∞ escalado (cm⁻¹)
let BOHR_RADIUS = 0.529;                    // a₀ escalado (Å)

// Constantes de conversión
let CM_TO_EV = 1.23981e-4;                  // 1 cm⁻¹ ≈ 1.23981×10⁻⁴ eV
let EV_TO_CM = 8065.54;                     // 1 eV ≈ 8065.54 cm⁻¹

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS ROTACIONALES (fn)
// ============================================================

// --- Niveles de Energía Rotacional (Rotor Rígido) ---
// E_J = B·J(J+1) donde J = 0, 1, 2, ...
// Params: constante_rotacional_B, número_cuántico_rotacional_J
fn "rotational_energy_level"(B, J) {
    B * J * (J + 1.0)
}

// --- Transiciones Rotacionales (Regla de selección: ΔJ = ±1) ---
// ΔE = E_J' - E_J = 2B(J+1) para J → J+1
// ν = 2B(J+1) en unidades de frecuencia
fn "rotational_transition_frequency"(B, J_lower) {
    2.0 * B * (J_lower + 1.0)
}

// --- Espectro Rotacional Puro (Serie de líneas equidistantes) ---
// Líneas en 2B, 4B, 6B, ... separadas por 2B
fn "pure_rotational_spectrum_intensity"(nu, B, T, J_max) {
    // Intensidad proporcional a degeneración y factor de Boltzmann
    let J = floor(nu/(2.0*B) - 0.5);  // J del nivel inferior
    let degeneracy = 2.0*J + 1.0;
    let energy = rotational_energy_level(B, J);
    degeneracy * exp(-energy/(0.695*T))  // 0.695 ≈ k_B en cm⁻¹/K
}

// --- Corrección por Distorsión Centrífuga ---
// E_J = B·J(J+1) - D·[J(J+1)]²
fn "rotational_energy_with_centrifugal"(B, D, J) {
    B * J * (J + 1.0) - D * J * J * (J + 1.0) * (J + 1.0)
}

// --- Constante de Rotación Dependiente del Nivel Vibratorio ---
// B_v = Bₑ - αₑ(v + ½)
fn "vibration_dependent_rotational_constant"(Be, alpha_e, v) {
    Be - alpha_e * (v + 0.5)
}

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS VIBRACIONALES (fn)
// ============================================================

// --- Oscilador Armónico Cuántico ---
// E_v = ωₑ(v + ½)
// Params: frecuencia_vibracional, número_cuántico_vibracional
fn "harmonic_oscillator_energy"(omega_e, v) {
    omega_e * (v + 0.5)
}

// --- Oscilador Anarmónico (Morse) ---
// E_v = ωₑ(v + ½) - ωₑχₑ(v + ½)²
fn "anharmonic_oscillator_energy"(omega_e, omega_e_chi_e, v) {
    omega_e * (v + 0.5) - omega_e_chi_e * (v + 0.5) * (v + 0.5)
}

// --- Transiciones Vibracionales (Δv = ±1, ±2, ...) ---
// ν = E_v' - E_v
fn "vibrational_transition_frequency"(omega_e, omega_e_chi_e, v_lower, delta_v) {
    let v_upper = v_lower + delta_v;
    anharmonic_oscillator_energy(omega_e, omega_e_chi_e, v_upper) - 
    anharmonic_oscillator_energy(omega_e, omega_e_chi_e, v_lower)
}

// --- Bandas Vibracionales (v" → v') ---
// Bandas fundamentales (Δv = 1), sobretonos (Δv = 2, 3, ...)
fn "vibrational_band_intensity"(v_lower, v_upper, transition_moment) {
    // Intensidad ∝ |<v'|μ|v">|² ≈ exp(-|v'-v"|)
    transition_moment * exp(-abs(v_upper - v_lower))
}

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS VIBRACIÓN-ROTACIÓN (fn)
// ============================================================

// --- Niveles de Energía Vibración-Rotación ---
// E_v,J = E_v + B_v·J(J+1) - D_v·[J(J+1)]²
fn "vibration_rotation_energy"(omega_e, omega_e_chi_e, B_v, D_v, v, J) {
    anharmonic_oscillator_energy(omega_e, omega_e_chi_e, v) + 
    rotational_energy_with_centrifugal(B_v, D_v, J)
}

// --- Rama R de Espectro Vibración-Rotación (ΔJ = +1) ---
// ν_R(J) = ν₀ + 2B'(J+1) + [B' - B"]J(J+1) para J = 0, 1, 2, ...
fn "vibration_rotation_R_branch"(nu0, B_prime, B_double_prime, J) {
    nu0 + 2.0 * B_prime * (J + 1.0) + (B_prime - B_double_prime) * J * (J + 1.0)
}

// --- Rama P de Espectro Vibración-Rotación (ΔJ = -1) ---
// ν_P(J) = ν₀ - 2B"J + [B' - B"]J(J-1) para J = 1, 2, 3, ...
fn "vibration_rotation_P_branch"(nu0, B_prime, B_double_prime, J) {
    nu0 - 2.0 * B_double_prime * J + (B_prime - B_double_prime) * J * (J - 1.0)
}

// --- Espaciado entre Líneas en Rama R/P ---
// Δν_R = ν_R(J) - ν_R(J-1) ≈ 2B' + 2(B' - B")J
fn "R_branch_line_spacing"(B_prime, B_double_prime, J) {
    2.0 * B_prime + 2.0 * (B_prime - B_double_prime) * J
}

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS ELECTRÓNICOS (fn)
// ============================================================

// --- Transiciones Electrónicas (Bandas) ---
// ν = Tₑ' - Tₑ" + E_v' - E_v" + E_J' - E_J"
fn "electronic_transition_frequency"(Te_prime, Te_double_prime, 
                                     omega_e_prime, omega_e_chi_e_prime,
                                     omega_e_double_prime, omega_e_chi_e_double_prime,
                                     B_prime, B_double_prime, v_prime, v_double_prime, J_prime, J_double_prime) {
    let delta_Te = Te_prime - Te_double_prime;
    let delta_vib = anharmonic_oscillator_energy(omega_e_prime, omega_e_chi_e_prime, v_prime) - 
                    anharmonic_oscillator_energy(omega_e_double_prime, omega_e_chi_e_double_prime, v_double_prime);
    let delta_rot = rotational_energy_level(B_prime, J_prime) - 
                    rotational_energy_level(B_double_prime, J_double_prime);
    
    delta_Te + delta_vib + delta_rot
}

// --- Intensidad de Franck-Condon (Transiciones Verticales) ---
// I ∝ |<χ_v'|χ_v">|² (integral de solapamiento vibracional)
fn "frank_condon_factor"(v_prime, v_double_prime, displacement) {
    // Aproximación: máximo para transiciones con mínimo desplazamiento
    exp(-abs(v_prime - v_double_prime) * displacement * displacement)
}

// --- Progresiones Vibracionales en Bandas Electrónicas ---
// Secuencia de bandas v" = 0, 1, 2, ... → v' = constante
fn "vibrational_progression_intensity"(v_double_prime, v_prime_max, displacement) {
    // Envolvente de distribución de Franck-Condon
    let v_prime_opt = displacement * displacement;  // v' óptimo
    exp(-(v_double_prime - v_prime_opt)*(v_double_prime - v_prime_opt) / (2.0 * v_prime_max))
}

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS DE ABSORCIÓN/EMISIÓN (fn)
// ============================================================

// --- Ley de Beer-Lambert (Absorción) ---
// I = I₀·exp(-ε·c·l)
fn "beer_lambert_absorption"(I0, epsilon, concentration, path_length) {
    I0 * exp(-epsilon * concentration * path_length)
}

// --- Coeficiente de Extinción Espectral ---
// ε(ν) = ε_max·L(ν, ν₀, γ) donde L es perfil de línea
fn "spectral_extinction_coefficient"(nu, nu0, epsilon_max, gamma, profile_type) {
    let lorentz = gamma / (2.0 * pi) / ((nu - nu0)*(nu - nu0) + gamma*gamma/4.0);
    let gauss = exp(-0.5*((nu - nu0)/(gamma/2.354)) * ((nu - nu0)/(gamma/2.354))) / (gamma/2.354 * sqrt(2.0*pi));
    
    epsilon_max * (profile_type * lorentz + (1.0 - profile_type) * gauss)
}

// --- Espectro de Emisión (Distribución de Planck × ε(ν)) ---
// I_em(ν, T) = ε(ν)·B_ν(T) donde B_ν es función de Planck
fn "thermal_emission_spectrum"(nu, T, nu0, epsilon_max, gamma) {
    let epsilon = spectral_extinction_coefficient(nu, nu0, epsilon_max, gamma, 0.5);
    let planck = (2.0 * 6.626e-34 * nu*nu*nu) / (299792458.0*299792458.0) * 
                 1.0 / (exp(6.626e-34 * nu / (1.380649e-23 * T)) - 1.0);
    
    epsilon * planck * 1e30  // Factor de escala
}

// --- Espectro de Fluorescencia (Desplazado Stokes) ---
// ν_flu = ν_exc - Δν_Stokes
fn "fluorescence_spectrum"(nu, nu_excitation, stokes_shift, width) {
    exp(-(nu - (nu_excitation - stokes_shift))*(nu - (nu_excitation - stokes_shift)) / (2.0 * width * width))
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs ESPECTRALES (def con custom)
// ============================================================

// --- Espectro Rotacional 3D (Serie de Líneas) ---
// 6 líneas J→J+1 (J=0..5); compuerta 1-step(J_max, J) emula range(0, J_max)
def "rotational_spectrum_3d"(B, T, J_max, intensity_threshold) {
    sdf: custom(y 
        - (1.0 - step(J_max, 0.0)) * exp(-sq(x*100.0 - 2.0*B)/0.01)
        - (1.0 - step(J_max, 1.0)) * exp(-sq(x*100.0 - 4.0*B)/0.01) * 3.0 * exp(-2.0*B/(0.695*T))
        - (1.0 - step(J_max, 2.0)) * exp(-sq(x*100.0 - 6.0*B)/0.01) * 5.0 * exp(-6.0*B/(0.695*T))
        - (1.0 - step(J_max, 3.0)) * exp(-sq(x*100.0 - 8.0*B)/0.01) * 7.0 * exp(-12.0*B/(0.695*T))
        - (1.0 - step(J_max, 4.0)) * exp(-sq(x*100.0 - 10.0*B)/0.01) * 9.0 * exp(-20.0*B/(0.695*T))
        - (1.0 - step(J_max, 5.0)) * exp(-sq(x*100.0 - 12.0*B)/0.01) * 11.0 * exp(-30.0*B/(0.695*T))
        - intensity_threshold);
}

// --- Espectro Vibracional (Oscilador Anarmónico) ---
// 8 bandas (v, v+Δv) para v=0..3, Δv=1,2; compuerta v+dv ≤ v_max
def "vibrational_spectrum_3d"(omega_e, omega_e_chi_e, T, v_max, intensity_threshold) {
    sdf: custom(y 
        - (1.0 - step(v_max + 0.5, 1.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)))/0.1) * exp(-1.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 2.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)))/0.1) * exp(-2.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 2.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)))/0.1) * exp(-1.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 3.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)))/0.1) * exp(-2.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 3.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)))/0.1) * exp(-1.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 4.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 4.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)))/0.1) * exp(-2.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 4.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 4.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0)))/0.1) * exp(-1.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0)/(0.695*T))
        - (1.0 - step(v_max + 0.5, 5.0)) * exp(-sq(x*100.0 - (anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 5.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0)))/0.1) * exp(-2.0) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 3.0)/(0.695*T))
        - intensity_threshold);
}

// --- Espectro Vibración-Rotación (Ramas R y P) ---
// R: J=0..5 (ΔJ=+1); P: J=1..6 (ΔJ=−1); compuertas por J_max
def "vibration_rotation_spectrum_3d"(nu0, B_prime, B_double_prime, T, J_max, intensity_threshold) {
    sdf: custom(y 
        - (1.0 - step(J_max, 0.0)) * exp(-sq(x*100.0 - (nu0 + 2.0*B_prime))/0.005)
        - (1.0 - step(J_max, 1.0)) * exp(-sq(x*100.0 - (nu0 + 4.0*B_prime + 2.0*(B_prime - B_double_prime)))/0.005) * 3.0 * exp(-2.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max, 2.0)) * exp(-sq(x*100.0 - (nu0 + 6.0*B_prime + 6.0*(B_prime - B_double_prime)))/0.005) * 5.0 * exp(-6.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max, 3.0)) * exp(-sq(x*100.0 - (nu0 + 8.0*B_prime + 12.0*(B_prime - B_double_prime)))/0.005) * 7.0 * exp(-12.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max, 4.0)) * exp(-sq(x*100.0 - (nu0 + 10.0*B_prime + 20.0*(B_prime - B_double_prime)))/0.005) * 9.0 * exp(-20.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max, 5.0)) * exp(-sq(x*100.0 - (nu0 + 12.0*B_prime + 30.0*(B_prime - B_double_prime)))/0.005) * 11.0 * exp(-30.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 1.0)) * exp(-sq(x*100.0 - (nu0 - 2.0*B_double_prime))/0.005) * 3.0 * exp(-2.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 2.0)) * exp(-sq(x*100.0 - (nu0 - 4.0*B_double_prime + 2.0*(B_prime - B_double_prime)))/0.005) * 5.0 * exp(-6.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 3.0)) * exp(-sq(x*100.0 - (nu0 - 6.0*B_double_prime + 6.0*(B_prime - B_double_prime)))/0.005) * 7.0 * exp(-12.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 4.0)) * exp(-sq(x*100.0 - (nu0 - 8.0*B_double_prime + 12.0*(B_prime - B_double_prime)))/0.005) * 9.0 * exp(-20.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 5.0)) * exp(-sq(x*100.0 - (nu0 - 10.0*B_double_prime + 20.0*(B_prime - B_double_prime)))/0.005) * 11.0 * exp(-30.0*B_double_prime/(0.695*T))
        - (1.0 - step(J_max + 0.5, 6.0)) * exp(-sq(x*100.0 - (nu0 - 12.0*B_double_prime + 30.0*(B_prime - B_double_prime)))/0.005) * 13.0 * exp(-42.0*B_double_prime/(0.695*T))
        - intensity_threshold);
}

// --- Progresión Vibracional (Bandas Electrónicas) ---
// 9 bandas v"→v' (v", v' = 0..2); compuertas por v_max
def "vibrational_progression_3d"(Te, omega_e, omega_e_chi_e, B, displacement, T, v_max, intensity_threshold) {
    sdf: custom(y 
        - (1.0 - step(v_max, 0.0)) * (1.0 - step(v_max, 0.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)))/(1.0 + 0.01*B)) * exp(-0.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)/(0.695*T))
        - (1.0 - step(v_max, 0.0)) * (1.0 - step(v_max, 1.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)))/(1.0 + 0.01*B)) * exp(-1.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)/(0.695*T))
        - (1.0 - step(v_max, 0.0)) * (1.0 - step(v_max, 2.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)))/(1.0 + 0.01*B)) * exp(-2.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0)/(0.695*T))
        - (1.0 - step(v_max, 1.0)) * (1.0 - step(v_max, 0.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)))/(1.0 + 0.01*B)) * exp(-1.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)/(0.695*T))
        - (1.0 - step(v_max, 1.0)) * (1.0 - step(v_max, 1.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)))/(1.0 + 0.01*B)) * exp(-0.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)/(0.695*T))
        - (1.0 - step(v_max, 1.0)) * (1.0 - step(v_max, 2.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)))/(1.0 + 0.01*B)) * exp(-1.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0)/(0.695*T))
        - (1.0 - step(v_max, 2.0)) * (1.0 - step(v_max, 0.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 0.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)))/(1.0 + 0.01*B)) * exp(-2.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)/(0.695*T))
        - (1.0 - step(v_max, 2.0)) * (1.0 - step(v_max, 1.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 1.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)))/(1.0 + 0.01*B)) * exp(-1.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)/(0.695*T))
        - (1.0 - step(v_max, 2.0)) * (1.0 - step(v_max, 2.0)) * exp(-sq(x*100.0 - (Te + anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0) - anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)))/(1.0 + 0.01*B)) * exp(-0.0*displacement*displacement) * exp(-anharmonic_oscillator_energy(omega_e, omega_e_chi_e, 2.0)/(0.695*T))
        - intensity_threshold);
}

// --- Espectro de Absorción (Ley de Beer-Lambert 3D) ---
// A(ν) = −log(exp(−ε(ν)·c·l) + 1e-6)
def "absorption_spectrum_3d"(nu0, epsilon_max, gamma, concentration, path_length, intensity_threshold) {
    sdf: custom(y 
        + log(exp(-spectral_extinction_coefficient(x*100.0, nu0, epsilon_max, gamma, 0.5) 
                  * concentration * path_length) + 1e-6)
        - intensity_threshold);
}

// --- Espectro de Emisión Térmica (Línea × Envolvente Térmica) ---
// I(ν) = (ε_max/50)·P(ν)·exp(−hν/kT), P = perfil lorentz/gauss compuesto;
// acotado para ε_max ≈ 50 (antes ε·B_ν·1e30 → ~436 en el centro de línea)
def "thermal_emission_line_3d"(nu0, epsilon_max, gamma, T, intensity_threshold) {
    sdf: custom(y 
        - (epsilon_max / 50.0)
          * (0.5 * (gamma/(2.0*pi))/(sq(x*100.0 - nu0) + gamma*gamma/4.0) 
             + 0.5 * exp(-0.5*sq((x*100.0 - nu0)/(gamma/2.354)))/(gamma/2.354 * sqrt(2.0*pi)))
          * exp(-6.626e-34*(x*100.0)/(1.380649e-23*T))
        - intensity_threshold);
}

// ============================================================
// INTERFAZ PÚBLICA - ESPECTROS MOLECULARES ESPECÍFICOS (def)
// ============================================================

// --- Espectro de la Molécula de CO (Monóxido de Carbono) ---
// B₀ ≈ 1.93 cm⁻¹, ωₑ ≈ 2170 cm⁻¹, ωₑχₑ = 13 cm⁻¹
def "CO_molecular_spectrum"(T, intensity_threshold) {
    sdf: custom(y 
        - 0.1 * (2.0*floor(x*10.0/3.86 - 0.5) + 1.0) * exp(-1.93*floor(x*10.0/3.86 - 0.5)*(floor(x*10.0/3.86 - 0.5) + 1.0)/(0.695*T))
        - exp(-sq(x*10.0 - (anharmonic_oscillator_energy(2170.0, 13.0, 1.0) - anharmonic_oscillator_energy(2170.0, 13.0, 0.0)))/100.0) * 0.5
        - intensity_threshold);
}

// --- Espectro de la Molécula de H₂O (Agua) ---
// Modos vibracionales (cm⁻¹): 3657, 1595, 3756; ensanchamiento térmico ∝ T
def "H2O_molecular_spectrum"(T, intensity_threshold) {
    sdf: custom(y 
        - exp(-sq(x*10.0 - 3657.0)/(50.0*(1.0 + T*0.001)))
        - exp(-sq(x*10.0 - 1595.0)/(50.0*(1.0 + T*0.001))) * 0.8
        - exp(-sq(x*10.0 - 3756.0)/(50.0*(1.0 + T*0.001))) * 0.6
        - intensity_threshold);
}

// --- Espectro de la Molécula de CO₂ (Dióxido de Carbono) ---
// Bandas IR: 667 cm⁻¹ (flexión) y 2349 cm⁻¹ (estiramiento asimétrico)
def "CO2_molecular_spectrum"(T, intensity_threshold) {
    sdf: custom(y 
        - exp(-sq(x*10.0 - 667.0)/(20.0*(1.0 + T*0.001))) * 1.0
        - exp(-sq(x*10.0 - 2349.0)/(20.0*(1.0 + T*0.001))) * 0.7
        - exp(-abs(x*10.0 - 500.0)/1000.0) * 0.3
        - intensity_threshold);
}

// ============================================================
// EJEMPLOS DE USO CON custom(expr)
// ============================================================

