// QUÍMICA INORGÁNICA: Estudio de compuestos no orgánicos, metales,
// minerales, compuestos de coordinación, materiales inorgánicos.
// Convenciones numéricas (el lenguaje no tiene strings/arrays/for):
//   - Los elementos se identifican por número atómico Z (1-118).
//   - period_of/group_of usan la tabla periódica completa (18 columnas;
//     lantánidos y actínidos se asignan al grupo 3).
//   - Códigos de geometría VSEPR:
//        2=lineal            3=trigonal plana      4=tetraédrica
//        5=bipirámide trig.  6=octaédrica          7=angular
//        8=piramidal trig.   9=balancín           10=forma T
//       11=piramidal cuad.  12=cuadrada plana      0=desconocida
//   - oxide_character: 1=ácido, 2=básico, 3=anfótero.
//   - electron_affinity_periodic: ΔH en kJ/mol (negativo = libera energía).
//   - chalcogenide_band_gap (eV): <1.5 negro, 1.5-2.5 coloreado, >2.5 blanco.

import "std_math_core.hm";
import "std_bridge_atomic.hm";

// ============================================================
// INTERFAZ PÚBLICA - ELEMENTOS Y PERIODICIDAD (fn)
// ============================================================

// --- Electrones de core (gas noble anterior) ---
fn "core_electron_count"(atomic_number) {
    let Z = atomic_number;
    2.0 * step(2.5, Z) + 8.0 * step(10.5, Z) + 8.0 * step(18.5, Z) + 18.0 * step(36.5, Z) + 18.0 * step(54.5, Z) + 32.0 * step(86.5, Z)
}

// --- Periodo (1-7) ---
fn "period_of"(atomic_number) {
    let Z = atomic_number;
    1.0 + step(2.5, Z) + step(10.5, Z) + step(18.5, Z) + step(36.5, Z) + step(54.5, Z) + step(86.5, Z)
}

// --- Grupo (1-18; lantánidos/actínidos → 3) ---
fn "group_of"(atomic_number) {
    let Z = atomic_number;
    let z = Z - core_electron_count(Z) - 1.0;
    let per = period_of(Z);
    z + 1.0
    + (17.0 * step(0.5, z) - z) * (1.0 - step(1.5, per))
    + 10.0 * step(1.5, z) * (step(1.5, per) - step(3.5, per))
    + ((2.0 - z) * step(2.5, z) * (1.0 - step(16.5, z)) - 14.0 * step(16.5, z)) * step(5.5, per)
}

// --- Electrones de valencia (Z menos el core del gas noble anterior) ---
fn "valence_electron_count"(atomic_number) {
    let Z = atomic_number;
    Z - core_electron_count(Z)
}

// --- Radio Atómico (Å, tendencia periódica) ---
fn "atomic_radius_periodic"(period, group) {
    let n = period;
    let z_eff = 2.0 + 0.5 * group + 0.3 * period;
    0.529 * n * n / z_eff
}

// --- Energía de Ionización (eV, apantallamiento saturante) ---
fn "ionization_energy_periodic"(atomic_number, ionization_degree) {
    let val = valence_electron_count(atomic_number);
    let per = period_of(atomic_number);
    let base = 0.65 + 1.6 * (1.0 - exp(-0.25 * val)) + 0.3 * (per - 1.0);
    let z_eff = base + 0.8 * (ionization_degree - 1.0);
    13.6 * z_eff * z_eff / (per * per)
}

// --- Electronegatividad de Pauling (modelo lineal grupo/periodo; H = 2.2) ---
fn "pauling_electronegativity"(atomic_number) {
    let g = group_of(atomic_number);
    let p = period_of(atomic_number);
    let chi = 0.9 + 0.15 * g - 0.08 * p;
    select(step(1.5, atomic_number), max(0.7, min(4.0, chi)), 2.2)
}

// --- Afinidad Electrónica (kJ/mol; gases nobles ≈ 0) ---
fn "electron_affinity_periodic"(atomic_number) {
    let g = group_of(atomic_number);
    let chi = pauling_electronegativity(atomic_number);
    let noble = step(17.5, g) - step(18.5, g);
    -110.0 * chi * (1.0 - noble)
}

// ============================================================
// INTERFAZ PÚBLICA - ENLACES INORGÁNICOS (fn)
// ============================================================

// --- Enlace Iónico (Energía de Red) ---
fn "ionic_lattice_energy"(cation_charge, anion_charge, cation_radius, anion_radius, madelung_constant) {
    let r0 = cation_radius + anion_radius;
    madelung_constant * cation_charge * anion_charge / (r0 + 1e-9) * 0.9
}

// --- Enlace Metálico (Modelo de Electrones Libres) ---
fn "metallic_bond_energy"(electron_density, fermi_energy) {
    0.6 * electron_density * fermi_energy
}

// --- Enlace Covalente (Solapamiento Orbital) ---
fn "covalent_bond_strength"(overlap_integral, bond_order) {
    overlap_integral * bond_order * 100.0
}

// --- Carácter Iónico (Pauling) ---
fn "percent_ionic_character"(electronegativity_diff) {
    (1.0 - exp(-electronegativity_diff * electronegativity_diff / 4.0)) * 100.0
}

// --- Longitud de Enlace (Suma de Radios) ---
fn "bond_length_covalent"(radius1, radius2, bond_order) {
    radius1 + radius2 - 0.07 * log(bond_order + 1e-9)
}

// ============================================================
// INTERFAZ PÚBLICA - GEOMETRÍA MOLECULAR (fn)
// ============================================================

// --- Teoría RPECV (VSEPR) → código de geometría ---
fn "vsepr_geometry"(electron_pairs, lone_pairs) {
    let t = electron_pairs + lone_pairs;
    select(step(5.5, t), select(step(1.5, lone_pairs), 12.0, select(step(0.5, lone_pairs), 11.0, 6.0)),
    select(step(4.5, t), select(step(2.5, lone_pairs), 2.0,
                       select(step(1.5, lone_pairs), 10.0,
                         select(step(0.5, lone_pairs), 9.0, 5.0))),
    select(step(3.5, t), select(step(2.5, lone_pairs), 2.0,
                       select(step(1.5, lone_pairs), 7.0,
                         select(step(0.5, lone_pairs), 8.0, 4.0))),
    select(step(2.5, t), select(step(1.5, lone_pairs), 2.0,
                       select(step(0.5, lone_pairs), 7.0, 3.0)),
    select(step(1.5, t), 2.0, 0.0)))))
}

// --- Ángulo de Enlace Representativo (°) ---
fn "bond_angles_vsepr"(geometry) {
    let g = geometry;
    select(step(11.5, g), 90.0,
    select(step(10.5, g), 85.0,
    select(step(9.5, g), 90.0,
    select(step(8.5, g), 102.0,
    select(step(7.5, g), 107.0,
    select(step(6.5, g), 104.5,
    select(step(5.5, g), 90.0,
    select(step(4.5, g), 120.0,
    select(step(3.5, g), 109.47,
    select(step(2.5, g), 120.0,
    select(step(1.5, g), 180.0, 109.47)))))))))))
}

// --- Distorsión por Pares Solitarios (°) ---
fn "lone_pair_distortion"(ideal_angle, lone_pairs) {
    ideal_angle - 2.5 * lone_pairs
}

// ============================================================
// INTERFAZ PÚBLICA - ESTADOS DE OXIDACIÓN (fn)
// ============================================================

// --- Estado de Oxidación Común (máximo/típico por grupo) ---
fn "common_oxidation_state"(group) {
    let g = group;
    select(step(17.5, g), 0.0,
    select(step(16.5, g), 7.0,
    select(step(15.5, g), 6.0,
    select(step(14.5, g), 5.0,
    select(step(13.5, g), 4.0,
    select(step(12.5, g), 3.0,
    select(step(11.5, g), 2.0,
    select(step(10.5, g), 3.0,
    select(step(9.5, g), 4.0,
    select(step(8.5, g), 6.0,
    select(step(7.5, g), 8.0, g)))))))))))
}

// --- Potencial de Reducción Estándar (V, heurístico) ---
fn "standard_reduction_potential"(atomic_number, oxidation_high, oxidation_low) {
    let chi = pauling_electronegativity(atomic_number);
    0.5 * (chi - 1.5) + 0.1 * (oxidation_high - oxidation_low)
}

// --- Estabilidad de Estados de Oxidación (0-1; cercanía a configuración noble) ---
// Configuraciones nobles consideradas: 0, 8, 10 (d10) y 18 electrones.
fn "oxidation_state_stability"(atomic_number, oxidation_state) {
    let v = valence_electron_count(atomic_number) - oxidation_state;
    let d = min(min(abs(v), abs(v - 8.0)), min(abs(v - 10.0), abs(v - 18.0)));
    max(0.0, min(1.0, 1.0 - d / 9.0))
}

// ============================================================
// INTERFAZ PÚBLICA - COMPUESTOS INORGÁNICOS (fn)
// ============================================================

// --- Óxidos (Carácter Ácido-Básico) ---
fn "oxide_character"(metal_electronegativity, oxygen_electronegativity) {
    let d = oxygen_electronegativity - metal_electronegativity;
    select(step(1.7, d), 1.0, select(step(1.0, d), 3.0, 2.0))
}

// --- Haluros (Estabilidad relativa) ---
fn "halide_stability"(cation_charge, halide_number, cation_radius) {
    cation_charge / (cation_radius + 1e-9) * halide_number * 0.1
}

// --- Calcogenuros (Band gap estimado, eV) ---
fn "chalcogenide_band_gap"(metal_atomic_number, chalcogen_atomic_number) {
    let en_metal = pauling_electronegativity(metal_atomic_number);
    let en_chalcogen = pauling_electronegativity(chalcogen_atomic_number);
    abs(en_chalcogen - en_metal) * 2.0
}

// --- Oxoaniones (Geometría) ---
fn "oxoanion_geometry"(oxygen_count, charge) {
    select(step(5.5, oxygen_count), 6.0,
    select(step(3.5, oxygen_count), 4.0,
    select(step(2.5, oxygen_count), select(step(-2.5, charge), 3.0, 8.0), 0.0)))
}

// ============================================================
// INTERFAZ PÚBLICA - SDFs DE QUÍMICA INORGÁNICA (def)
// ============================================================

// --- Estructura Cristalina Sal (NaCl) ---
// Celda rocksalt: 4 Na + 4 Cl (Na en esquinas y centros de cara alternos).
def "nacl_crystal_structure"(lattice_constant) {
    sdf: custom(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y) + sq(z)) - 0.22 * lattice_constant,
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y - 0.5 * lattice_constant) + sq(z)) - 0.22 * lattice_constant),
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y) + sq(z - 0.5 * lattice_constant)) - 0.22 * lattice_constant),
        sqrt(sq(x) + sq(y - 0.5 * lattice_constant) + sq(z - 0.5 * lattice_constant)) - 0.22 * lattice_constant),
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y) + sq(z)) - 0.28 * lattice_constant),
        sqrt(sq(x) + sq(y - 0.5 * lattice_constant) + sq(z)) - 0.28 * lattice_constant),
        sqrt(sq(x) + sq(y) + sq(z - 0.5 * lattice_constant)) - 0.28 * lattice_constant),
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y - 0.5 * lattice_constant) + sq(z - 0.5 * lattice_constant)) - 0.28 * lattice_constant))
}

// --- Geometría Molecular VSEPR en 3D ---
// bond_pairs: pares enlazantes (1-6); lone_pairs: pares libres (0-3).
def "vsepr_molecular_geometry"(bond_pairs, lone_pairs) {
    sdf: custom(min(min(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y) + sq(z)) - 0.045,
        sqrt(sq(x - 0.2 * step(0.5, bond_pairs)) + sq(y) + sq(z)) - 0.035 * step(0.5, bond_pairs)),
        sqrt(sq(x - (-0.2 + 0.1 * (step(2.5, bond_pairs) - step(3.5, bond_pairs) + step(4.5, bond_pairs) - step(5.5, bond_pairs))) * step(1.5, bond_pairs)) + sq(y) + sq(z - 0.1732 * (step(2.5, bond_pairs) - step(3.5, bond_pairs) + step(4.5, bond_pairs) - step(5.5, bond_pairs)) * step(1.5, bond_pairs))) - 0.035 * step(1.5, bond_pairs)),
        sqrt(sq(x + 0.1 * (step(2.5, bond_pairs) - step(3.5, bond_pairs) + step(4.5, bond_pairs) - step(5.5, bond_pairs)) * step(2.5, bond_pairs)) + sq(y) + sq(z - (0.2 - 0.3732 * (step(2.5, bond_pairs) - step(3.5, bond_pairs) + step(4.5, bond_pairs) - step(5.5, bond_pairs))) * step(2.5, bond_pairs))) - 0.035 * step(2.5, bond_pairs)),
        sqrt(sq(x) + sq(y + 0.2 * (step(4.5, bond_pairs) - step(5.5, bond_pairs)) * step(3.5, bond_pairs)) + sq(z + 0.2 * (1.0 - (step(4.5, bond_pairs) - step(5.5, bond_pairs))) * step(3.5, bond_pairs))) - 0.035 * step(3.5, bond_pairs)),
        sqrt(sq(x) + sq(y - 0.2 * step(4.5, bond_pairs)) + sq(z)) - 0.035 * step(4.5, bond_pairs)),
        sqrt(sq(x) + sq(y + 0.2 * step(5.5, bond_pairs)) + sq(z)) - 0.035 * step(5.5, bond_pairs)),
        sqrt(sq(x - 0.15 * step(0.5, lone_pairs)) + sq(y - 0.12 * step(0.5, lone_pairs)) + sq(z)) - 0.055 * step(0.5, lone_pairs)),
        sqrt(sq(x + 0.075 * step(1.5, lone_pairs)) + sq(y - 0.12 * step(1.5, lone_pairs)) + sq(z - 0.13 * step(1.5, lone_pairs))) - 0.055 * step(1.5, lone_pairs)),
        sqrt(sq(x + 0.075 * step(2.5, lone_pairs)) + sq(y - 0.12 * step(2.5, lone_pairs)) + sq(z + 0.13 * step(2.5, lone_pairs))) - 0.055 * step(2.5, lone_pairs)))
}

// --- Complejo de Coordinación Octaédrico ---
def "octahedral_coordination_complex"(ligand_distance, metal_radius, ligand_radius, bond_radius) {
    sdf: custom(min(min(min(min(min(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y) + sq(z)) - metal_radius,
        sqrt(sq(x - ligand_distance) + sq(y) + sq(z)) - ligand_radius),
        sqrt(sq(x + ligand_distance) + sq(y) + sq(z)) - ligand_radius),
        sqrt(sq(x) + sq(y - ligand_distance) + sq(z)) - ligand_radius),
        sqrt(sq(x) + sq(y + ligand_distance) + sq(z)) - ligand_radius),
        sqrt(sq(x) + sq(y) + sq(z - ligand_distance)) - ligand_radius),
        sqrt(sq(x) + sq(y) + sq(z + ligand_distance)) - ligand_radius),
        segment_distance(x, y, z, 0, 0, 0, ligand_distance, 0, 0) - bond_radius),
        segment_distance(x, y, z, 0, 0, 0, -ligand_distance, 0, 0) - bond_radius),
        segment_distance(x, y, z, 0, 0, 0, 0, ligand_distance, 0) - bond_radius),
        segment_distance(x, y, z, 0, 0, 0, 0, -ligand_distance, 0) - bond_radius),
        segment_distance(x, y, z, 0, 0, 0, 0, 0, ligand_distance) - bond_radius),
        segment_distance(x, y, z, 0, 0, 0, 0, 0, -ligand_distance) - bond_radius))
}

// --- Óxido Metálico (Sustrato + Capa de Óxido) ---
def "metal_oxide_layer"(metal_thickness, oxide_thickness, half_width) {
    sdf: union(box(half_width, metal_thickness, half_width),
        custom(max(max(x - half_width, -half_width - x), max(max(z - half_width, -half_width - z), max(metal_thickness - y, y - metal_thickness - oxide_thickness)))))
}

// --- Red Cristalina de Fluorita (CaF2) ---
// Ca en las 8 esquinas de la celda; F en los 8 huecos tetraédricos (a/4, 3a/4).
def "fluorite_crystal_structure"(lattice_constant) {
    sdf: custom(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y) + sq(z)) - 0.16 * lattice_constant,
        sqrt(sq(x - lattice_constant) + sq(y) + sq(z)) - 0.16 * lattice_constant),
        sqrt(sq(x) + sq(y - lattice_constant) + sq(z)) - 0.16 * lattice_constant),
        sqrt(sq(x) + sq(y) + sq(z - lattice_constant)) - 0.16 * lattice_constant),
        sqrt(sq(x - lattice_constant) + sq(y - lattice_constant) + sq(z)) - 0.16 * lattice_constant),
        sqrt(sq(x - lattice_constant) + sq(y) + sq(z - lattice_constant)) - 0.16 * lattice_constant),
        sqrt(sq(x) + sq(y - lattice_constant) + sq(z - lattice_constant)) - 0.16 * lattice_constant),
        sqrt(sq(x - lattice_constant) + sq(y - lattice_constant) + sq(z - lattice_constant)) - 0.16 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.1 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.1 * lattice_constant))
}

// --- Semiconductores Inorgánicos (motivo zinc blenda) ---
// Placa inferior de espesor proporcional al band gap.
def "inorganic_semiconductor_structure"(lattice_constant, band_gap) {
    sdf: union(custom(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y) + sq(z)) - 0.13 * lattice_constant,
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y - 0.5 * lattice_constant) + sq(z)) - 0.13 * lattice_constant),
        sqrt(sq(x - 0.5 * lattice_constant) + sq(y) + sq(z - 0.5 * lattice_constant)) - 0.13 * lattice_constant),
        sqrt(sq(x) + sq(y - 0.5 * lattice_constant) + sq(z - 0.5 * lattice_constant)) - 0.13 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.13 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.25 * lattice_constant)) - 0.13 * lattice_constant),
        sqrt(sq(x - 0.75 * lattice_constant) + sq(y - 0.25 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.13 * lattice_constant),
        sqrt(sq(x - 0.25 * lattice_constant) + sq(y - 0.75 * lattice_constant) + sq(z - 0.75 * lattice_constant)) - 0.13 * lattice_constant)),
        custom(max(max(x - 0.4, -0.4 - x), max(max(z - 0.4, -0.4 - z), max(-0.205 - 0.01 * band_gap - y, y + 0.2)))))
}

// --- Vidrio Inorgánico (Sílice amorfa) ---
// 5 tetraedros SiO (Si + O puente) con corrimiento dependiente del desorden.
def "inorganic_glass_silica"(disorder_factor) {
    sdf: custom(min(min(min(min(min(min(min(min(min(
        sqrt(sq(x - 0.05 * sin(disorder_factor)) + sq(y - 0.3) + sq(z)) - 0.035,
        sqrt(sq(x - 0.08 - 0.05 * sin(disorder_factor)) + sq(y - 0.3) + sq(z)) - 0.022),
        sqrt(sq(x - 0.1933 - 0.05 * (0.9636 * cos(disorder_factor) + 0.2675 * sin(disorder_factor))) + sq(y - 0.1865) + sq(z - 0.2674)) - 0.035),
        sqrt(sq(x - 0.2733 - 0.05 * (0.9636 * cos(disorder_factor) + 0.2675 * sin(disorder_factor))) + sq(y - 0.1865) + sq(z - 0.2674)) - 0.022),
        sqrt(sq(x - 0.2956 - 0.05 * (0.5155 * cos(disorder_factor) - 0.8569 * sin(disorder_factor))) + sq(y + 0.0682) + sq(z - 0.2425)) - 0.035),
        sqrt(sq(x - 0.3756 - 0.05 * (0.5155 * cos(disorder_factor) - 0.8569 * sin(disorder_factor))) + sq(y + 0.0682) + sq(z - 0.2425)) - 0.022),
        sqrt(sq(x - 0.2590 - 0.05 * (-0.6878 * cos(disorder_factor) - 0.7259 * sin(disorder_factor))) + sq(y + 0.2712) + sq(z + 0.0473)) - 0.035),
        sqrt(sq(x - 0.3390 - 0.05 * (-0.6878 * cos(disorder_factor) - 0.7259 * sin(disorder_factor))) + sq(y + 0.2712) + sq(z + 0.0473)) - 0.022),
        sqrt(sq(x - 0.1005 - 0.05 * (-0.8835 * cos(disorder_factor) + 0.4685 * sin(disorder_factor))) + sq(y + 0.2690) + sq(z + 0.2855)) - 0.035),
        sqrt(sq(x - 0.1805 - 0.05 * (-0.8835 * cos(disorder_factor) + 0.4685 * sin(disorder_factor))) + sq(y + 0.2690) + sq(z + 0.2855)) - 0.022))
}

// --- Material Cerámico (Al2O3) ---
// Granos esféricos con poros esféricos sustraídos (porosidad 0-1).
def "ceramic_alumina_structure"(grain_size, porosity) {
    sdf: subtract(custom(min(min(min(
        sqrt(sq(x - 0.5 * grain_size) + sq(y) + sq(z - 0.5 * grain_size)) - 0.4 * grain_size,
        sqrt(sq(x + 0.5 * grain_size) + sq(y) + sq(z - 0.5 * grain_size)) - 0.4 * grain_size),
        sqrt(sq(x - 0.5 * grain_size) + sq(y) + sq(z + 0.5 * grain_size)) - 0.4 * grain_size),
        sqrt(sq(x + 0.5 * grain_size) + sq(y) + sq(z + 0.5 * grain_size)) - 0.4 * grain_size)),
        custom(min(min(min(
        sqrt(sq(x - 0.5 * grain_size) + sq(y) + sq(z - 0.5 * grain_size)) - (0.0005 + 0.15 * grain_size * porosity),
        sqrt(sq(x + 0.5 * grain_size) + sq(y) + sq(z - 0.5 * grain_size)) - (0.0005 + 0.15 * grain_size * porosity)),
        sqrt(sq(x - 0.5 * grain_size) + sq(y) + sq(z + 0.5 * grain_size)) - (0.0005 + 0.15 * grain_size * porosity)),
        sqrt(sq(x + 0.5 * grain_size) + sq(y) + sq(z + 0.5 * grain_size)) - (0.0005 + 0.15 * grain_size * porosity))))
}

// --- Catalizador Inorgánico (Superficie) ---
// Soporte + hasta 6 sitios activos; adsorbatos en la mitad de los sitios.
def "inorganic_catalyst_surface"(active_sites) {
    sdf: union(box(0.45, 0.02, 0.45), custom(min(min(min(min(min(min(min(min(
        sqrt(sq(x) + sq(y - 0.03 * step(0.5, active_sites)) + sq(z - 0.3 * step(0.5, active_sites))) - 0.02 * step(0.5, active_sites),
        sqrt(sq(x - 0.299 * step(1.5, active_sites)) + sq(y - 0.03 * step(1.5, active_sites)) + sq(z - 0.021 * step(1.5, active_sites))) - 0.02 * step(1.5, active_sites)),
        sqrt(sq(x - 0.042 * step(2.5, active_sites)) + sq(y - 0.03 * step(2.5, active_sites)) + sq(z + 0.297 * step(2.5, active_sites))) - 0.02 * step(2.5, active_sites)),
        sqrt(sq(x + 0.293 * step(3.5, active_sites)) + sq(y - 0.03 * step(3.5, active_sites)) + sq(z + 0.063 * step(3.5, active_sites))) - 0.02 * step(3.5, active_sites)),
        sqrt(sq(x + 0.084 * step(4.5, active_sites)) + sq(y - 0.03 * step(4.5, active_sites)) + sq(z - 0.288 * step(4.5, active_sites))) - 0.02 * step(4.5, active_sites)),
        sqrt(sq(x - 0.281 * step(5.5, active_sites)) + sq(y - 0.03 * step(5.5, active_sites)) + sq(z - 0.104 * step(5.5, active_sites))) - 0.02 * step(5.5, active_sites)),
        sqrt(sq(x) + sq(y - 0.06 * step(1.0, active_sites)) + sq(z - 0.25 * step(1.0, active_sites))) - 0.015 * step(1.0, active_sites)),
        sqrt(sq(x - 0.035 * step(3.0, active_sites)) + sq(y - 0.06 * step(3.0, active_sites)) + sq(z + 0.247 * step(3.0, active_sites))) - 0.015 * step(3.0, active_sites)),
        sqrt(sq(x + 0.070 * step(5.0, active_sites)) + sq(y - 0.06 * step(5.0, active_sites)) + sq(z - 0.240 * step(5.0, active_sites))) - 0.015 * step(5.0, active_sites))))
}

// ============================================================
// NOTAS PARA USUARIOS
// ============================================================

// 1. La química inorgánica estudia todos los elementos salvo la mayoría del carbono.
// 2. Las tendencias periódicas (radio, IE, electronegatividad) usan un modelo
//    simplificado documentado; sirven para comparar tendencias, no valores exactos.
// 3. Los enlaces iónico, metálico y covalente dan lugar a estructuras diversas.
// 4. La teoría VSEPR predice geometrías moleculares a partir de pares enlazantes/libres.
// 5. Los estados de oxidación determinan reactividad y estequiometría.
// 6. Los materiales inorgánicos (semiconductores, cerámicos, catalizadores, vidrios)
//    son tecnológicamente importantes.
// 7. Los SDFs son deterministas: todos los bucles/arrays originales se expandieron
//    manualmente con compuertas step() sobre los parámetros.
