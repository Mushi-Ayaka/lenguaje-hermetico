// ============================================================
// LIBRERÍA: std_chem_optics.hm
// CAPA:     Química (Capa 4 - Óptica Química: Fresnel, BRDF, refracción)
// VERSIÓN:  1.2
// FUENTE:   Schlick "Ideal Reflectance", Cook-Torrance "Microfacet Theory"
// DEPS:     std_math_core.hm
// FECHA:    6 de junio de 2026 (reescrita 2026-10-23, optimizada 2026-11-04)
// ============================================================

// ÓPTICA QUÍMICA: Reflectancia de Fresnel, modelos de BRDF, dispersión,
// absorción espectral, efectos de interfase y transiciones ópticas.
// Convenciones numéricas (el lenguaje no tiene strings/arrays/for):
//   - metal_index: 0=Ag 1=Au 2=Cu 3=Al
//   - cos_theta / N_dot_X: cosenos directores en [0,1] (el llamador los calcula)
//   - wavelengths en nm; ángulos en radianes.
//   - Los *_field son helpers internos: precalculan subexpresiones con let
//     para que las SDF no repitan raíces ni trigonometricas.

import "std_math_core.hm";

// ============================================================
// CONSTANTES ÓPTICAS
// ============================================================

let F0_DIELECTRIC = 0.04;
let CAUCHY_A_DEFAULT = 1.5;
let CAUCHY_B_DEFAULT = 0.004;
let CAUCHY_C_DEFAULT = 0.0001;

// ============================================================
// INTERFAZ PÚBLICA - PROPIEDADES ÓPTICAS DE METALES (fn)
// ============================================================

// --- Índice de refracción complejo n (parte real) @ 600nm ---
fn "ior_metal_index"(metal_index) {
    0.05 + 0.15 * step(0.5, metal_index) + 0.42 * step(1.5, metal_index) + 0.82 * step(2.5, metal_index)
}

// --- Coeficiente de extinción k @ 600nm ---
// Cu necesita un extra sobre la base de Au (k_Cu ~ 3.4, no 2.6).
fn "ior_metal_extinction"(metal_index) {
    3.5 - 0.5 * step(0.5, metal_index) - 0.38 * step(1.5, metal_index) + 0.8 * (step(1.5, metal_index) - step(2.5, metal_index)) + 2.61 * step(2.5, metal_index)
}

// ============================================================
// INTERFAZ PÚBLICA - REFLECTANCIA DE FRESNEL (fn)
// ============================================================

// --- Fresnel Exacto (S-polarizado) ---
// R_s = |(n1·cosθ1 - n2·cosθ2)/(n1·cosθ1 + n2·cosθ2)|²
fn "fresnel_exact_s"(n1, n2, theta1) {
    let theta2 = asin(clamp(n1 * sin(theta1) / n2, -1.0, 1.0));
    let c1 = cos(theta1);
    let c2 = cos(theta2);
    let numerator = n1 * c1 - n2 * c2;
    let denominator = n1 * c1 + n2 * c2;
    (numerator * numerator) / (denominator * denominator + 1e-6)
}

// --- Fresnel Exacto (P-polarizado) ---
// R_p = |(n2·cosθ1 - n1·cosθ2)/(n2·cosθ1 + n1·cosθ2)|²
fn "fresnel_exact_p"(n1, n2, theta1) {
    let theta2 = asin(clamp(n1 * sin(theta1) / n2, -1.0, 1.0));
    let c1 = cos(theta1);
    let c2 = cos(theta2);
    let numerator = n2 * c1 - n1 * c2;
    let denominator = n2 * c1 + n1 * c2;
    (numerator * numerator) / (denominator * denominator + 1e-6)
}

// --- Fresnel No Polarizado (Promedio) ---
// Una sola refracción: evita repetir asin/sin/cos de S y P.
fn "fresnel_unpolarized"(n1, n2, theta1) {
    let theta2 = asin(clamp(n1 * sin(theta1) / n2, -1.0, 1.0));
    let c1 = cos(theta1);
    let c2 = cos(theta2);
    let s_num = n1 * c1 - n2 * c2;
    let s_den = n1 * c1 + n2 * c2;
    let p_num = n2 * c1 - n1 * c2;
    let p_den = n2 * c1 + n1 * c2;
    0.5 * ((s_num * s_num) / (s_den * s_den + 1e-6) + (p_num * p_num) / (p_den * p_den + 1e-6))
}

// --- Aproximación de Schlick ---
// F(θ) = F0 + (1 - F0)·(1 - cosθ)⁵ ; (1-c)⁵ por multiplicaciones.
fn "schlick_fresnel"(F0, cos_theta) {
    let c = 1.0 - cos_theta;
    let c2 = c * c;
    F0 + (1.0 - F0) * c2 * c2 * c
}

// --- Fresnel Complejo (Metales con coeficiente de extinción k) ---
fn "fresnel_complex"(n, k, cos_theta) {
    let n2 = n * n;
    let k2 = k * k;
    let cos2 = cos_theta * cos_theta;
    let n2k2 = n2 + k2;
    let r_s = ((n2k2) * cos2 - 2.0 * n * cos_theta + 1.0) / ((n2k2) * cos2 + 2.0 * n * cos_theta + 1.0);
    let r_p = ((n2k2) - 2.0 * n * cos_theta + cos2) / ((n2k2) + 2.0 * n * cos_theta + cos2);
    0.5 * (r_s + r_p)
}

// --- Fresnel Conductor (Schlick modificado por rugosidad) ---
fn "conductor_fresnel"(F0, cos_theta, rough) {
    let base = schlick_fresnel(F0, cos_theta);
    let r = clamp(rough, 0.0, 1.0);
    base * (1.0 - r * 0.5) + r * 0.5 * F0
}

// --- Fresnel normal de un dieléctrico: F0 = ((n-1)/(n+1))² ---
fn "dielectric_f0"(ior_value) {
    let d = ior_value - 1.0;
    let s = ior_value + 1.0;
    (d * d) / (s * s + 1e-9)
}

// ============================================================
// INTERFAZ PÚBLICA - BRDFs Y MICROFACETAS (fn)
// ============================================================

// --- BRDF de Lambert (Difuso perfecto) ---
fn "lambert_brdf"(rho_diffuse) {
    rho_diffuse / pi
}

// --- BRDF de Phong (Especular empírico) ---
fn "phong_brdf"(specular_strength, shininess, R_dot_V) {
    ((shininess + 2.0) / (2.0 * pi)) * specular_strength * pow(max(R_dot_V, 0.0), shininess)
}

// --- BRDF de Blinn-Phong (Más eficiente) ---
fn "blinn_phong_brdf"(specular_strength, shininess, N_dot_H) {
    ((shininess + 8.0) / (8.0 * pi)) * specular_strength * pow(max(N_dot_H, 0.0), shininess)
}

// --- BRDF de Cook-Torrance (Microfacetas) ---
fn "cook_torrance_brdf"(D, G, F, N_dot_L, N_dot_V) {
    (D * G * F) / (4.0 * max(N_dot_L, 1e-6) * max(N_dot_V, 1e-6) + 1e-6)
}

// --- Distribución de Microfacetas (GGX/Trowbridge-Reitz) ---
fn "ggx_distribution"(a_rough, N_dot_H) {
    let a2 = a_rough * a_rough;
    let h2 = N_dot_H * N_dot_H;
    let t = h2 * (a2 - 1.0) + 1.0;
    a2 / (pi * t * t + 1e-9)
}

// --- Distribución de Microfacetas (Beckmann) ---
fn "beckmann_distribution"(a_rough, N_dot_H) {
    let c2 = N_dot_H * N_dot_H;
    let c4 = c2 * c2;
    let a2 = a_rough * a_rough;
    let tan2 = (1.0 - c2) / (c2 + 1e-6);
    exp(-tan2 / (a2 + 1e-9)) / (pi * a2 * c4 + 1e-9)
}

// --- Función de Geometría (Smith con GGX) ---
fn "smith_ggx_geometry"(a_rough, N_dot_X) {
    let a2 = a_rough * a_rough;
    let x2 = N_dot_X * N_dot_X;
    let denom = N_dot_X + sqrt(a2 + (1.0 - a2) * x2);
    2.0 * N_dot_X / (denom + 1e-6)
}

// --- Función de Geometría (Schlick con GGX) ---
fn "schlick_ggx_geometry"(a_rough, N_dot_X) {
    let k = a_rough * 0.5;
    N_dot_X / (N_dot_X * (1.0 - k) + k + 1e-6)
}

// ============================================================
// INTERFAZ PÚBLICA - ABSORCIÓN Y DISPERSIÓN (fn)
// ============================================================

// --- Ley de Beer-Lambert (Absorción volumétrica) ---
fn "beer_lambert_absorption"(I0, mu, dist) {
    I0 * exp(-mu * dist)
}

// --- Coeficiente de Absorción Espectral (banda gaussiana) ---
// width = semiancho 1/e (no sigma); pico = strength en el centro.
fn "spectral_absorption_coefficient"(wavelength, band_center, band_width, strength) {
    let d = wavelength - band_center;
    let w = band_width * band_width + 1e-9;
    strength * exp(-(d * d) / w)
}

// --- Dispersión de Rayleigh (λ⁻⁴) ---
fn "rayleigh_scattering_coefficient"(wavelength, base_coeff) {
    let r = 550.0 / (wavelength + 1e-9);
    let r2 = r * r;
    base_coeff * r2 * r2
}

// --- Dispersión de Mie (partículas grandes) ---
fn "mie_scattering_coefficient"(wavelength, base_coeff, size_parameter) {
    base_coeff * pow(550.0 / (wavelength + 1e-9), size_parameter)
}

// --- Dispersión Combinada (Atmósfera) ---
fn "atmospheric_scattering"(wavelength, rayleigh_strength, mie_strength) {
    rayleigh_scattering_coefficient(wavelength, rayleigh_strength) + mie_scattering_coefficient(wavelength, mie_strength, 0.84)
}

// --- Índice de Refracción por Dispersión (Cauchy) ---
fn "cauchy_dispersion_law"(wavelength_nm, A, B, C) {
    let lambda_um = wavelength_nm / 1000.0;
    let l2 = lambda_um * lambda_um;
    A + B / l2 + C / (l2 * l2)
}

// --- Cauchy con coeficientes por defecto (vidrio común) ---
fn "cauchy_dispersion_default"(wavelength_nm) {
    cauchy_dispersion_law(wavelength_nm, CAUCHY_A_DEFAULT, CAUCHY_B_DEFAULT, CAUCHY_C_DEFAULT)
}

// --- Dispersión de Sellmeier escalarizada (3 términos) ---
fn "sellmeier_dispersion_law"(wavelength_nm, B1, B2, B3, C1, C2, C3) {
    let lambda_um = wavelength_nm / 1000.0;
    let l2 = lambda_um * lambda_um;
    let n2 = 1.0 + B1 * l2 / (l2 - C1) + B2 * l2 / (l2 - C2) + B3 * l2 / (l2 - C3);
    sqrt(max(n2, 0.0))
}

// ============================================================
// INTERFAZ PÚBLICA - MATERIALES ESPECÍFICOS (fn)
// ============================================================

// --- Reflectancia de Metal ---
// La modulación espectral vale 1 en 600nm (referencia de las constantes).
fn "metal_reflectance"(F0, cos_theta, rough, wavelength) {
    let fresnel = conductor_fresnel(F0, cos_theta, rough);
    let dispersion = 1.0 + 0.1 * sin((wavelength - 600.0) * 0.01);
    fresnel * dispersion
}

// --- Reflectancia de Dieléctrico (F0 desde el IOR real) ---
fn "dielectric_reflectance"(ior_value, cos_theta, sss) {
    let fresnel = schlick_fresnel(dielectric_f0(ior_value), cos_theta);
    fresnel + clamp(sss, 0.0, 1.0) * (1.0 - fresnel) * 0.5
}

// --- Reflectancia de Plástico (Difuso + Especular) ---
fn "plastic_reflectance"(diffuse_color, specular_strength, rough, cos_theta) {
    let s = clamp(specular_strength, 0.0, 1.0);
    let diffuse = diffuse_color * (1.0 - s);
    let specular = s * schlick_fresnel(F0_DIELECTRIC, cos_theta);
    diffuse + specular
}

// --- Reflectancia de Vidrio (Transmisión + Reflexión) ---
fn "glass_reflectance"(ior_value, thickness, absorption_coeff, cos_theta) {
    let reflection = schlick_fresnel(dielectric_f0(ior_value), cos_theta);
    let trans_val = (1.0 - reflection) * exp(-absorption_coeff * thickness);
    reflection + trans_val * 0.5
}

// --- Reflectancia de Agua ---
fn "water_reflectance"(depth, turbidity, cos_theta, wavelength) {
    let fresnel = schlick_fresnel(0.02, cos_theta);
    let absorption = spectral_absorption_coefficient(wavelength, 450.0, 50.0, 0.1) + spectral_absorption_coefficient(wavelength, 650.0, 50.0, 0.05);
    let attenuation = exp(-(absorption + turbidity * 0.1) * depth);
    fresnel + (1.0 - fresnel) * attenuation * 0.3
}

// --- Reflectancia de Piel (Subsurface Scattering) ---
// Pesos 0.6/0.3/0.03: la suma se mantiene por debajo de 1.
fn "skin_reflectance"(diffuse_color, subsurface_color, thickness, cos_theta) {
    let direct_reflection = schlick_fresnel(0.028, cos_theta);
    let sss_term = subsurface_color * exp(-thickness * 2.0) * (1.0 - direct_reflection);
    diffuse_color * (1.0 - direct_reflection) * 0.6 + sss_term * 0.3 + direct_reflection
}

// ============================================================
// INTERFAZ PÚBLICA - EFECTOS ESPECIALES (fn)
// ============================================================

// --- Interferencia de Película Delgada ---
fn "thin_film_interference"(thickness, ior_value, cos_theta, wavelength) {
    let optical_path = 2.0 * ior_value * thickness * cos_theta;
    let phase = (optical_path / (wavelength + 1e-9) + 0.5) * 2.0 * pi;
    0.5 + 0.5 * cos(phase)
}

// --- Reflectancia Anisotrópica (metal cepillado) ---
fn "anisotropic_reflectance"(rough, anisotropy, tangent_dot_H, bitangent_dot_H) {
    let ax = rough * (1.0 + anisotropy);
    let ay = rough * (1.0 - anisotropy);
    ggx_distribution(ax, tangent_dot_H) * ggx_distribution(ay, bitangent_dot_H) * 0.5
}

// --- Clear Coat (F0 desde el IOR del barniz) ---
fn "clear_coat_reflectance"(base_reflectance, clear_coat_ior, cos_theta) {
    let coat_reflection = schlick_fresnel(dielectric_f0(clear_coat_ior), cos_theta);
    let base_visible = 1.0 - coat_reflection;
    coat_reflection + base_visible * base_reflectance
}

// --- Sheen (tejidos, felpa) ---
fn "sheen_reflectance"(sheen_color, sheen_rough, cos_theta) {
    let r = clamp(sheen_rough, 0.0, 1.0);
    let grazing_reflection = schlick_fresnel(0.04, cos_theta);
    sheen_color * grazing_reflection * (1.0 - r) + r * 0.1
}

// --- Translucencia (aproximación difusiva) ---
// exp(-d·μ_s)·exp(-d·μ_a) = exp(-d·(μ_s+μ_a)).
fn "translucency_transmission"(thickness, scatter_coeff, absorption_coeff) {
    exp(-thickness * (scatter_coeff + absorption_coeff))
}

// --- Cavidad Fabry-Pérot (transmisión) ---
fn "fabry_perot_transmission"(cavity_length, mirror_reflectivity, wavelength, cos_theta) {
    let om = 1.0 - mirror_reflectivity;
    let F = 4.0 * mirror_reflectivity / (om * om + 1e-9);
    let phase = 4.0 * pi * cavity_length * cos_theta / (wavelength + 1e-9);
    let s = sin(phase * 0.5);
    let t_max = 1.0 / (1.0 + F);
    t_max / (1.0 + F * s * s)
}

// --- Sagitta de superficie esférica ---
fn "surface_sagitta"(R, r) {
    R - sqrt(max(R * R - r * r, 0.0))
}

// --- Compuerta suave (smoothstep manual) ---
fn "smooth_gate"(edge0, edge1, v) {
    let s = sat((v - edge0) / (edge1 - edge0 + 1e-9));
    s * s * (3.0 - 2.0 * s)
}

// ============================================================
// HELPERS DE CAMPO (fn con let; evitan repetir subexpresiones en las SDF)
// ============================================================

// --- Altura Cook-Torrance para la SDF ---
fn "cook_torrance_field"(rough, metal_amount, base_tint, N_dot_V, N_dot_L, N_dot_H, intensity_threshold) {
    let a = max(rough, 0.02);
    let D = ggx_distribution(a, N_dot_H);
    let G = smith_ggx_geometry(a, N_dot_V) * smith_ggx_geometry(a, N_dot_L);
    let F = F0_DIELECTRIC + (base_tint - F0_DIELECTRIC) * metal_amount;
    cook_torrance_brdf(D, G, F, N_dot_L, N_dot_V) - intensity_threshold
}

// --- Altura de dispersión de Cauchy (eje radial = λ) ---
fn "cauchy_dispersion_field"(A, B, C, thickness, wavelength_range, dispersion_strength, x, z) {
    let r = sqrt(x * x + z * z);
    let wl = 400.0 + wavelength_range * r;
    thin_film_interference(thickness, cauchy_dispersion_law(wl, A, B, C), 1.0, wl) * dispersion_strength
}

// --- Altura de película delgada interferométrica ---
// cosθ = 1/sqrt(1+r²): incidencia normal en el centro, rasante al alejarse.
fn "thin_film_field"(thickness, ior_value, wavelength_base, x, z) {
    let r = sqrt(x * x + z * z);
    let cos_t = 1.0 / sqrt(1.0 + r * r);
    let wl = wavelength_base * (1.0 + 0.1 * sin(r * 10.0));
    thin_film_interference(thickness, ior_value, cos_t, wl)
}

// --- Altura de absorción espectral de 2 bandas ---
fn "spectral_absorption_field"(band_center_1, band_width_1, band_strength_1, band_center_2, band_width_2, band_strength_2, depth, x, z) {
    let wl = 400.0 + 300.0 * sqrt(x * x + z * z);
    let mu = spectral_absorption_coefficient(wl, band_center_1, band_width_1, band_strength_1) + spectral_absorption_coefficient(wl, band_center_2, band_width_2, band_strength_2);
    1.0 - beer_lambert_absorption(1.0, mu, depth)
}

// --- Altura de lente con aberración cromática (3 sagittas) ---
fn "chromatic_lens_field"(base_radius, thickness, material_A, material_B, material_C, x, z) {
    let r = sqrt(x * x + z * z);
    let n_R = cauchy_dispersion_law(700.0, material_A, material_B, material_C);
    let n_G = cauchy_dispersion_law(550.0, material_A, material_B, material_C);
    let n_B = cauchy_dispersion_law(450.0, material_A, material_B, material_C);
    let R_R = base_radius * 2.0 / (n_R - 1.0 + 1e-9);
    let R_G = base_radius * 2.0 / (n_G - 1.0 + 1e-9);
    let R_B = base_radius * 2.0 / (n_B - 1.0 + 1e-9);
    surface_sagitta(R_R, r) * 0.3 + surface_sagitta(R_G, r) * 0.4 + surface_sagitta(R_B, r) * 0.3 - thickness * 0.5
}

// --- Altura de cavidad Fabry-Pérot ---
// cosθ = L/sqrt(L²+r²) (ángulo cuya tangente es r/L).
fn "fabry_perot_field"(cavity_length, mirror_reflectivity, wavelength, x, z) {
    let r2 = x * x + z * z;
    let cos_t = cavity_length / sqrt(cavity_length * cavity_length + r2);
    fabry_perot_transmission(cavity_length, mirror_reflectivity, wavelength, cos_t)
}

// --- Altura de red de difracción ---
fn "grating_field"(grating_period, groove_depth, wavelength, order, x) {
    let u = (mod_unit(x / grating_period) - 0.5) * grating_period;
    let groove = smooth_gate(-groove_depth, groove_depth, abs(u) - grating_period * 0.25);
    let fringes = 0.5 + 0.5 * cos(2.0 * pi * x / grating_period * order * wavelength * 100.0);
    groove * fringes
}

// --- Altura de cristal fotónico (un agujero centrado por celda) ---
// Al centrar la celda en 0 basta un agujero: la periodicidad la da mod_unit.
fn "photonic_crystal_field"(lattice_constant, hole_radius, dielectric_contrast, x, z) {
    let px = (mod_unit(x / lattice_constant) - 0.5) * lattice_constant;
    let pz = (mod_unit(z / lattice_constant) - 0.5) * lattice_constant;
    let hole = sqrt(px * px + pz * pz) - hole_radius;
    let modulation = 0.5 + 0.5 * cos(2.0 * pi * x / lattice_constant) * cos(2.0 * pi * z / lattice_constant);
    hole * modulation * dielectric_contrast
}

// ============================================================
// SDFs ÓPTICAS (def con custom; sin let en def)
// ============================================================

// --- Superficie con BRDF de Cook-Torrance (altura = BRDF) ---
def "cook_torrance_surface"(rough, metal_amount, base_tint, N_dot_V, N_dot_L, N_dot_H, intensity_threshold) {
    sdf: custom(y - cook_torrance_field(rough, metal_amount, base_tint, N_dot_V, N_dot_L, N_dot_H, intensity_threshold));
}

// --- Material con Dispersión de Cauchy (eje radial = λ) ---
def "cauchy_dispersion_material"(A, B, C, thickness, wavelength_range, dispersion_strength) {
    sdf: custom(y - cauchy_dispersion_field(A, B, C, thickness, wavelength_range, dispersion_strength, x, z));
}

// --- Película Delgada Interferométrica ---
def "thin_film_interference_surface"(thickness, ior_value, wavelength_base, intensity_threshold) {
    sdf: custom(y - thin_film_field(thickness, ior_value, wavelength_base, x, z) - intensity_threshold);
}

// --- Material con Absorción Espectral (2 bandas) ---
def "spectral_absorption_material"(band_center_1, band_width_1, band_strength_1, band_center_2, band_width_2, band_strength_2, depth, intensity_threshold) {
    sdf: custom(y - spectral_absorption_field(band_center_1, band_width_1, band_strength_1, band_center_2, band_width_2, band_strength_2, depth, x, z) - intensity_threshold);
}

// --- Material Anisotrópico (cosenos T·H y B·H dados por el llamador) ---
def "anisotropic_material_surface"(rough, anisotropy, tangent_dot_H, bitangent_dot_H, intensity_threshold) {
    sdf: custom(y - anisotropic_reflectance(rough, anisotropy, tangent_dot_H, bitangent_dot_H) - intensity_threshold);
}

// --- Material con Subsurface Scattering ---
def "subsurface_scattering_material"(scatter_coeff, absorption_coeff, thickness, intensity_threshold) {
    sdf: custom(y - translucency_transmission(thickness, scatter_coeff, absorption_coeff) * exp(-(x * x + z * z) / (thickness * thickness * 4.0 + 1e-9)) - intensity_threshold);
}

// --- Lente con Aberración Cromática (3 sagittas ponderadas) ---
def "chromatic_lens_dispersion"(base_radius, thickness, material_A, material_B, material_C) {
    sdf: custom(y - chromatic_lens_field(base_radius, thickness, material_A, material_B, material_C, x, z));
}

// --- Cavidad Fabry-Pérot ---
def "fabry_perot_cavity"(cavity_length, mirror_reflectivity, wavelength, intensity_threshold) {
    sdf: custom(y - fabry_perot_field(cavity_length, mirror_reflectivity, wavelength, x, z) - intensity_threshold);
}

// --- Red de Difracción ---
def "diffraction_grating"(grating_period, groove_depth, wavelength, order, intensity_threshold) {
    sdf: custom(y - grating_field(grating_period, groove_depth, wavelength, order, x) - intensity_threshold);
}

// --- Cristal Fotónico (agujeros en rejilla cuadrada) ---
def "photonic_crystal"(lattice_constant, hole_radius, dielectric_contrast, intensity_threshold) {
    sdf: custom(y - photonic_crystal_field(lattice_constant, hole_radius, dielectric_contrast, x, z) - intensity_threshold);
}

// ============================================================
// EJEMPLOS DE USO (comentados)
// ============================================================

/*
// Superficie Cook-Torrance: N_dot_V=0.9, N_dot_L=0.7, N_dot_H=0.8
node "cook_torrance_example" {
    position: [-4, 0, 0];
    sdf: cook_torrance_surface(0.2, 0.0, 0.8, 0.9, 0.7, 0.8, 0.3);
    material: "pbr_material";
}
// Dispersión de Cauchy (A=1.5, B=0.004, C=0.0001)
node "cauchy_dispersion_example" {
    position: [0, 0, 0];
    sdf: cauchy_dispersion_material(1.5, 0.004, 0.0001, 0.1, 300.0, 1.0);
    material: "dispersive";
}
// Película delgada interferométrica
node "thin_film_example" {
    position: [4, 0, 0];
    sdf: thin_film_interference_surface(0.1, 1.5, 550.0, 0.3);
    material: "interference";
}
// Cavidad Fabry-Pérot
node "fabry_perot_example" {
    position: [0, -3, 0];
    sdf: fabry_perot_cavity(1.0, 0.9, 0.55, 0.3);
    material: "optical_cavity";
}
*/

// ============================================================
// NOTAS
// ============================================================
// 1. Los BRDFs son escalares: el llamador pasa los cosenos directores ya calculados.
// 2. Constantes ópticas = valores típicos @ 600nm; aproximaciones visuales.
// 3. Las SDFs ópticas son relieves (altura = propiedad óptica) sobre medio espacio y<0.
// 4. Nombres de parámetros con sufijo (_value, _amount, rough) evitan keywords del lexer.
// 5. Los *_field existen solo para precalcular con let; no son API de usuario.
// 6. Pow solo se usa con exponente variable (Phong/Blinn/Mie); exponentes fijos
//    son productos encadenados (Schlick⁵, Rayleigh⁴) para no expandir código.
