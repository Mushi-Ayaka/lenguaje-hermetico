// QUÍMICA TEÓRICA Y COMPUTACIONAL: métodos cuánticos computacionales,
// dinámica molecular, Monte Carlo, optimización geométrica, análisis
// vibracional y visualizaciones de conceptos abstractos.
// Convenciones numéricas (el lenguaje no tiene arrays/for/fn-callbacks):
//   - Los vectores se manejan componente a componente; el llamador pasa
//     ya calculados los cosenos/energías que necesiten las fórmulas.
//   - Energías en kJ/mol salvo metropolis/gibbs (J por partícula, k_B).
//   - frecuencias en cm⁻¹ para zero_point_energy; el resto en unidades
//     coherentes con las constantes indicadas.
//   - Los *_field son helpers internos: precalculan con let para que las
//     SDF no repitan subexpresiones.

import "std_math_core.hm";

// ============================================================
// CONSTANTES FUNDAMENTALES
// ============================================================

let BOLTZMANN_THEOR = 1.380649e-23;       // k_B (J/K)
let PLANCK_THEOR = 6.62607015e-34;        // h (J·s)
let AVOGADRO_THEOR = 6.02214076e23;       // N_A (mol⁻¹)
let LIGHT_SPEED = 2.99792458e8;           // c (m/s)

// ============================================================
// HELPERS (fn con let; se expanden dentro de las SDF)
// ============================================================

// --- Esfera centrada en (cx,cy,cz) ---
fn "sphere_field"(cx, cy, cz, radius, x, y, z) {
    let dx = x - cx;
    let dy = y - cy;
    let dz = z - cz;
    sqrt(dx * dx + dy * dy + dz * dz) - radius
}

// --- erfc(x) por la aproximación racional de Numerical Recipes ---
// Precisión ~1e-7 en todo el eje; para x<0 usa erfc(-x) = 2 - erfc(x).
fn "erfc_approx"(x) {
    let ax = abs(x);
    let t = 1.0 / (1.0 + 0.5 * ax);
    let poly = 1.00002368 + t * (0.37409196 + t * (0.09678418 + t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 + t * (-0.82215223 + t * 0.17087277)))))));
    let tau = t * exp(-ax * ax - 1.26551223 + t * poly);
    tau + step(0.0, -x) * (2.0 - 2.0 * tau)
}

// --- Superficie de energía potencial: doble pozo + pared en z ---
fn "pes_field"(barrier_height, well_separation, x, z) {
    let a2 = well_separation * well_separation;
    let q = x * x - a2;
    let scaled = q * q / (a2 * a2 + 1e-9);
    barrier_height * min(scaled, 1.0) + 0.1 * z * z
}

// --- Tubo de trayectoria MD: y = drift·x + A·sin(kx + w/2) ---
// Distancia radial en el plano (y,z) para que el tubo tenga sección real.
fn "md_trajectory_field"(amplitude, wavelength, tube_radius, drift, x, y, z) {
    let phase = PI2 * x / (wavelength + 1e-6) + w * 0.5;
    let dy = y - drift * x - amplitude * sin(phase);
    sqrt(dy * dy + z * z) - tube_radius
}

// --- Histograma MC: barras periódicas de altura variable ---
// Altura de campo (independiente de z); gate recorta cada barra.
fn "mc_bars_field"(acceptance_rate, bar_height, bar_width, x, y) {
    let spacing = 0.2;
    let idx = floor(x / spacing);
    let u = (x / spacing - idx - 0.5) * spacing;
    let gate = 1.0 - step(bar_width, abs(u));
    let variation = 0.5 + 0.5 * sin(idx * 1.7);
    y - bar_height * acceptance_rate * variation * gate
}

// --- Rampa de optimización con ondulación amortiguada ---
fn "opt_pathway_field"(start_height, end_height, ripple, x, z) {
    let t = sat((x + 1.5) / 3.0);
    let ramp = start_height + (end_height - start_height) * t;
    ramp + ripple * sin(x * 6.0) * exp(-x * x * 0.2) + 0.05 * z * z
}

// --- Átomo i de un modo normal (oscilación alterna en y, animada por w) ---
fn "vib_atom_field"(amplitude, frequency, atom_index, gate, x, y, z) {
    let parity = atom_index - 2.0 * floor(atom_index * 0.5);
    let alternation = 1.0 - 2.0 * parity;
    let displacement = amplitude * sin(frequency * w) * alternation;
    sphere_field(-0.2 + atom_index * 0.1, displacement, 0.0, 0.03 * gate, x, y, z)
}

// --- Punto (i,j) de la malla DFT en el plano XZ; peso gaussiano ---
fn "dft_grid_dot_field"(grid_density, dot_i, dot_j, x, y, z) {
    let gate = (1.0 - step(grid_density, dot_i)) * (1.0 - step(grid_density, dot_j));
    let px = (dot_i - 2.0) * 0.12;
    let pz = (dot_j - 2.0) * 0.12;
    let weight = exp(-(px * px + pz * pz) / 0.1);
    sphere_field(px, 0.0, pz, (0.004 + 0.012 * weight) * gate, x, y, z)
}

// ============================================================
// INTERFAZ PÚBLICA - MÉTODOS CUÁNTICOS (fn)
// ============================================================

// --- Funcional DFT (B3LYP híbrido) ---
// 0.20·HF + 0.80·Slater + 0.72·B88 + 0.81·LYP
fn "b3lyp_exchange_correlation"(density, gradient, kinetic_energy_density) {
    let rho = max(density, 1e-6);
    let r43 = pow(rho, 4.0 / 3.0);
    let b88 = gradient * gradient / (r43 + 1e-9);
    let lyp = rho * exp(-0.1 * rho);
    0.2 * kinetic_energy_density + 0.8 * r43 + 0.72 * b88 + 0.81 * lyp
}

// --- Correlación MP2 de un par (i,j)→(a,b) ---
// E = -0.25·|⟨ij||ab⟩|²/(ε_a+ε_b-ε_i-ε_j)
fn "mp2_pair_correlation"(energy_gap, integral) {
    -0.25 * integral * integral / (energy_gap + 1e-6)
}

// --- Correlación MP2 total (pares activos × energía media de par) ---
fn "mp2_energy_computation"(energy_gap, integral, pair_count) {
    pair_count * mp2_pair_correlation(energy_gap, integral)
}

// --- Costo Computacional Hartree-Fock: O(N⁴) ---
fn "hartree_fock_cost"(basis_functions) {
    let n2 = basis_functions * basis_functions;
    n2 * n2
}

// --- Costo Computacional DFT: O(N³) + O(N·G) ---
fn "dft_cost"(basis_functions, grid_points) {
    let n2 = basis_functions * basis_functions;
    n2 * basis_functions + basis_functions * grid_points
}

// --- Costo Computacional CCSD(T): O(N⁷) ---
fn "ccsdt_cost"(basis_functions) {
    let n2 = basis_functions * basis_functions;
    let n4 = n2 * n2;
    n4 * n2 * basis_functions
}

// --- Ahorro de la aproximación Resolution of Identity ---
// De O(N⁴) a O(N²·M): fracción ahorrada = 1 − M/N².
fn "ri_approximation_savings"(basis_functions, auxiliary_functions) {
    let n2 = basis_functions * basis_functions;
    clamp(1.0 - auxiliary_functions / (n2 + 1e-9), 0.0, 1.0)
}

// ============================================================
// INTERFAZ PÚBLICA - DINÁMICA MOLECULAR (fn)
// ============================================================

// --- Velocity-Verlet: nueva posición (una componente) ---
fn "velocity_verlet_position"(position_value, velocity, acceleration, dt) {
    position_value + velocity * dt + 0.5 * acceleration * dt * dt
}

// --- Velocity-Verlet: media velocidad (una componente) ---
// La velocidad completa requiere la aceleración nueva tras el paso.
fn "velocity_verlet_velocity"(velocity, acceleration, dt) {
    velocity + 0.5 * acceleration * dt
}

// --- Energía de Lennard-Jones: 4ε[(σ/r)¹² − (σ/r)⁶] ---
fn "lennard_jones_energy"(distance_r, epsilon, sigma) {
    let sr = sigma / (distance_r + 1e-6);
    let sr2 = sr * sr;
    let sr6 = sr2 * sr2 * sr2;
    4.0 * epsilon * (sr6 * sr6 - sr6)
}

// --- Fuerza de Lennard-Jones: 24ε/r·[2(σ/r)¹² − (σ/r)⁶] ---
fn "lennard_jones_force"(distance_r, epsilon, sigma) {
    let sr = sigma / (distance_r + 1e-6);
    let sr2 = sr * sr;
    let sr6 = sr2 * sr2 * sr2;
    24.0 * epsilon / (distance_r + 1e-6) * (2.0 * sr6 * sr6 - sr6)
}

// --- Energía de Enlace Armónico ---
fn "harmonic_bond_energy"(distance_r, r0, k_bond) {
    let d = distance_r - r0;
    0.5 * k_bond * d * d
}

// --- Energía de Ángulo Armónico ---
fn "harmonic_angle_energy"(theta, theta0, k_angle) {
    let d = theta - theta0;
    0.5 * k_angle * d * d
}

// --- Energía de Torsión (Dihedro) ---
fn "torsion_energy"(phi, barrier, periodicity, gamma) {
    barrier * (1.0 + cos(periodicity * phi - gamma))
}

// --- Par electrostático directo de Ewald (con erfc aproximada) ---
// Devuelve 0 fuera de la esfera de corte.
fn "ewald_direct_pair"(charge_i, charge_j, distance_r, alpha_value, cutoff) {
    let inside = 1.0 - step(cutoff, distance_r);
    let r = max(distance_r, 1e-6);
    inside * charge_i * charge_j * erfc_approx(alpha_value * r) / r
}

// ============================================================
// INTERFAZ PÚBLICA - MONTE CARLO (fn)
// ============================================================

// --- Criterio de Metropolis: probabilidad de aceptación (0..1) ---
// ΔE en J por partícula; el llamador compara con un número aleatorio.
fn "metropolis_criterion"(energy_change, temperature) {
    let exponent = -energy_change / (BOLTZMANN_THEOR * max(temperature, 1e-9));
    min(1.0, exp(clamp(exponent, -40.0, 40.0)))
}

// --- Desplazamiento MC de traslación (una componente) ---
// uniform_sample es un número en [0,1) que aporta el llamador.
fn "mc_translation_step"(max_displacement, uniform_sample) {
    (uniform_sample - 0.5) * 2.0 * max_displacement
}

// --- Giro MC de rotación (un ángulo) ---
fn "mc_rotation_step"(max_rotation, uniform_sample) {
    (uniform_sample - 0.5) * 2.0 * max_rotation
}

// --- Media de Gibbs ponderada por Boltzmann (dos configuraciones) ---
fn "gibbs_sampling_average"(value_a, value_b, energy_a, energy_b, temperature) {
    let kt = BOLTZMANN_THEOR * max(temperature, 1e-9);
    let wa = exp(clamp(-energy_a / kt, -40.0, 40.0));
    let wb = exp(clamp(-energy_b / kt, -40.0, 40.0));
    (value_a * wa + value_b * wb) / (wa + wb + 1e-30)
}

// ============================================================
// INTERFAZ PÚBLICA - OPTIMIZACIÓN GEOMÉTRICA (fn)
// ============================================================

// --- Gradiente numérico por diferencias centrales (una componente) ---
// El llamador evalúa la energía en x+δ y x−δ.
fn "energy_gradient_numerical"(energy_plus, energy_minus, delta) {
    (energy_plus - energy_minus) / (2.0 * delta + 1e-12)
}

// --- Elemento diagonal del Hessiano por diferencias centrales ---
fn "hessian_diagonal"(e_pp, e_pm, e_mp, e_mm, delta) {
    (e_pp - e_pm - e_mp + e_mm) / (4.0 * delta * delta + 1e-12)
}

// --- Convergencia: 1 si ambos criterios se cumplen, 0 si no ---
fn "optimization_converged"(gradient_norm, energy_change, threshold_gradient, threshold_energy) {
    (1.0 - step(threshold_gradient, gradient_norm)) * (1.0 - step(threshold_energy, abs(energy_change)))
}

// --- Actualización BFGS 1D: curvatura secante H = Δg/Δx ---
fn "bfgs_hessian_update_1d"(gradient_diff, position_diff) {
    gradient_diff / (position_diff + 1e-9)
}

// ============================================================
// INTERFAZ PÚBLICA - ANÁLISIS VIBRACIONAL (fn)
// ============================================================

// --- Frecuencia vibracional de un autovalor del Hessiano ---
// Negativa = frecuencia imaginaria (punto de silla).
fn "vibrational_frequency"(hessian_eigenvalue, mass) {
    let magnitude = sqrt(abs(hessian_eigenvalue) / (max(mass, 1e-9)));
    sign_approx(hessian_eigenvalue) * magnitude
}

// --- Intensidad IR: I ∝ |∂μ/∂Q|² ---
fn "infrared_intensity"(dipole_derivative) {
    dipole_derivative * dipole_derivative
}

// --- Actividad Raman: A ∝ |∂α/∂Q|² ---
fn "raman_activity"(polarizability_derivative) {
    polarizability_derivative * polarizability_derivative
}

// --- Energía de punto cero de un modo (ν̃ en cm⁻¹ → kJ/mol) ---
fn "zero_point_energy"(wavenumber) {
    0.5 * PLANCK_THEOR * LIGHT_SPEED * wavenumber * 100.0 * AVOGADRO_THEOR / 1000.0
}

// ============================================================
// SDFs DE CÓMPUTO QUÍMICO (def con custom; sin let en def)
// ============================================================

// --- Superficie de Energía Potencial (doble pozo) ---
def "potential_energy_surface_computational"(barrier_height, well_separation, intensity_threshold) {
    sdf: custom(y - pes_field(barrier_height, well_separation, x, z) - intensity_threshold);
}

// --- Trayectoria de Dinámica Molecular (tubo ondulado animado) ---
def "md_trajectory_visualization"(amplitude, wavelength, tube_radius, drift, intensity_threshold) {
    sdf: custom(md_trajectory_field(amplitude, wavelength, tube_radius, drift, x, y, z) - intensity_threshold);
}

// --- Muestreo Monte Carlo (histograma de barras + esfera de aceptación) ---
def "monte_carlo_sampling_visualization"(acceptance_rate, bar_height, bar_width, intensity_threshold) {
    sdf: custom(min(mc_bars_field(acceptance_rate, bar_height, bar_width, x, y), sphere_field(0.6, acceptance_rate * 0.3, 0.0, 0.05, x, y, z)) - intensity_threshold);
}

// --- Trayectoria de Optimización Geométrica (rampa descendente) ---
def "geometry_optimization_pathway"(start_height, end_height, ripple, intensity_threshold) {
    sdf: custom(y - opt_pathway_field(start_height, end_height, ripple, x, z) - intensity_threshold);
}

// --- Modos Vibracionales Animados (5 átomos, oscilación alterna) ---
def "vibrational_mode_animation"(amplitude, frequency, atom_count, intensity_threshold) {
    sdf: custom(min(vib_atom_field(amplitude, frequency, 0.0, 1.0 - step(atom_count, 0.0), x, y, z), min(vib_atom_field(amplitude, frequency, 1.0, 1.0 - step(atom_count, 1.0), x, y, z), min(vib_atom_field(amplitude, frequency, 2.0, 1.0 - step(atom_count, 2.0), x, y, z), min(vib_atom_field(amplitude, frequency, 3.0, 1.0 - step(atom_count, 3.0), x, y, z), vib_atom_field(amplitude, frequency, 4.0, 1.0 - step(atom_count, 4.0), x, y, z))))) - intensity_threshold);
}

// --- Malla de Integración DFT (rejilla 5×5 + núcleo central) ---
def "dft_integration_grid_visualization"(grid_density, intensity_threshold) {
    sdf: custom(min(sphere_field(0.0, 0.0, 0.0, 0.04, x, y, z), min(dft_grid_dot_field(grid_density, 0.0, 0.0, x, y, z), min(dft_grid_dot_field(grid_density, 0.0, 1.0, x, y, z), min(dft_grid_dot_field(grid_density, 0.0, 2.0, x, y, z), min(dft_grid_dot_field(grid_density, 0.0, 3.0, x, y, z), min(dft_grid_dot_field(grid_density, 0.0, 4.0, x, y, z), min(dft_grid_dot_field(grid_density, 1.0, 0.0, x, y, z), min(dft_grid_dot_field(grid_density, 1.0, 1.0, x, y, z), min(dft_grid_dot_field(grid_density, 1.0, 2.0, x, y, z), min(dft_grid_dot_field(grid_density, 1.0, 3.0, x, y, z), min(dft_grid_dot_field(grid_density, 1.0, 4.0, x, y, z), min(dft_grid_dot_field(grid_density, 2.0, 0.0, x, y, z), min(dft_grid_dot_field(grid_density, 2.0, 1.0, x, y, z), min(dft_grid_dot_field(grid_density, 2.0, 2.0, x, y, z), min(dft_grid_dot_field(grid_density, 2.0, 3.0, x, y, z), min(dft_grid_dot_field(grid_density, 2.0, 4.0, x, y, z), min(dft_grid_dot_field(grid_density, 3.0, 0.0, x, y, z), min(dft_grid_dot_field(grid_density, 3.0, 1.0, x, y, z), min(dft_grid_dot_field(grid_density, 3.0, 2.0, x, y, z), min(dft_grid_dot_field(grid_density, 3.0, 3.0, x, y, z), min(dft_grid_dot_field(grid_density, 3.0, 4.0, x, y, z), min(dft_grid_dot_field(grid_density, 4.0, 0.0, x, y, z), min(dft_grid_dot_field(grid_density, 4.0, 1.0, x, y, z), min(dft_grid_dot_field(grid_density, 4.0, 2.0, x, y, z), min(dft_grid_dot_field(grid_density, 4.0, 3.0, x, y, z), dft_grid_dot_field(grid_density, 4.0, 4.0, x, y, z)))))))))))))))))))))))))) - intensity_threshold);
}

