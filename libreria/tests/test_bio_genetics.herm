// Test de std_bio_genetics.hm

scene {
    background: [0, 0, 0];
}

import "std_math_core.hm"
import "std_math_algebra.hm"
import "std_math_probability.hm"
import "std_bio_genetics.hm"

material "genetic" {}

// Test fn puras - Genética de Poblaciones
let hw_heterozygotes = hardy_weinberg_equilibrium(0.7);  // p = 0.7 → 2*0.7*0.3 = 0.42
let allele_freq = allele_frequency_from_genotypes(0.49, 0.42, 0.09);  // Debería ser ~0.7

// Test fn puras - Epigenética
let methylation_next = dna_methylation_dynamics(0.8, 0.05, 0.02);  // 0.8 → 0.81
let epigenetic_inherit = epigenetic_inheritance(0.85, 0.9, 0.1);

// Test fn puras - Replicación de ADN
let parental_dna = semiconservative_replication(3);  // Después de 3 generaciones
let replication_fidelity = dna_replication_fidelity(1000, 1e-7);

// Test def: Doble hélice de ADN
instance "dna_double_helix"(0.08, 3.4) {
    position: [0, 0, 0];
}

// Test def: Cromosoma en metafase
instance "metaphase_chromosome"(1.2, 0.3) {
    position: [1.5, 0, 0];
}

// Test def: Patrón de metilación CpG
instance "cpg_methylation_pattern"(1.0) {
    position: [-1.5, 0, 0];
}