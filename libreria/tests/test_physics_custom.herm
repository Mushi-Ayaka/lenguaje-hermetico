// ============================================================
// ARCHIVO DE PRUEBA: test_physics_custom.herm
// OBJETIVO: Validar std_phys_sdf.hm con primitiva custom(expr)
// FECHA: 6 de junio de 2026
// ============================================================

// Escena básica
scene {
    background: [0.05, 0.05, 0.1];
    axes { X: 400, Y: 300, W: 1 }
    camera {
        position: [0, 0, 5];
        target: [0, 0, 0];
        fov: 50;
    }
}

// Materiales básicos
material "default" {}
material "water" {}
material "glass" {}
material "emissive" {}

// ============================================================
// PRUEBA 1: CUSTOM SDF BÁSICA
// ============================================================

// Primero definimos una función simple para usar con custom()
fn "simple_sine_surface"(amplitude, frequency) {
    y - amplitude * sin(x * frequency + z * frequency * 0.7)
}

node "custom_sine_wave" {
    position: [-3, 2, 0];
    sdf: custom(simple_sine_surface(0.2, 3.0));
    material: "default";
}

// ============================================================
// PRUEBA 2: ONDA DE GRAVEDAD (custom con función física)
// ============================================================

// Función de onda de gravedad
fn "test_gravity_wave"(amp, k, t) {
    y - amp * sin(k * x - sqrt(9.8 * k) * t) * exp(-k * abs(z))
}

node "gravity_wave_test" {
    position: [0, 2, 0];
    sdf: custom(test_gravity_wave(0.15, 4.0, w));
    material: "water";
}

// ============================================================
// PRUEBA 3: LENTE ESFÉRICA (custom con ecuación óptica)
// ============================================================

// Superficie esférica (sagitta)
fn "test_spherical_surface"(R, h) {
    let r_sq = x*x + z*z;
    y - (R - sqrt(R*R - r_sq) - h)
}

node "spherical_lens_test" {
    position: [3, 2, 0];
    sdf: custom(test_spherical_surface(2.0, 0.5));
    material: "glass";
}

// ============================================================
// PRUEBA 4: CAMPO DE TEMPERATURA (custom con difusión)
// ============================================================

// Campo de temperatura gaussiano
fn "test_temperature_field"(T0, D, t) {
    let r_sq = x*x + z*z;
    let temp = T0 * exp(-r_sq / (4.0 * D * t + 0.1)) / sqrt(4.0 * pi * D * t + 0.1);
    temp - 0.3  // Isosuperficie a temperatura 0.3
}

node "temperature_field_test" {
    position: [-3, 0, 0];
    sdf: custom(test_temperature_field(1.0, 0.2, w * 0.5 + 1.0));
    material: "emissive";
}

// ============================================================
// PRUEBA 5: VÓRTICE FLUÍDICO (custom con flujo rotacional)
// ============================================================

// Campo de presión de vórtice
fn "test_vortex_pressure"(Gamma, rc, t) {
    let r = sqrt(x*x + z*z);
    let theta = atan2(z, x);
    let v_theta = Gamma / (2.0 * pi * max(r, rc));
    let pressure = -0.5 * v_theta * v_theta;
    pressure + 0.05 * sin(theta * 4.0 - t * 2.0) + 0.1
}

node "fluid_vortex_test" {
    position: [0, 0, 0];
    sdf: custom(test_vortex_pressure(1.5, 0.3, w));
    material: "water";
}

// ============================================================
// PRUEBA 6: SUPERFICIE ALGEBRAICA COMPLEJA
// ============================================================

// Superficie implícita algebraica (toroide algebraico)
fn "test_algebraic_surface"(a, b, c) {
    let x2 = x*x;
    let y2 = y*y;
    let z2 = z*z;
    (x2 + y2 + z2 + b*b - a*a)*(x2 + y2 + z2 + b*b - a*a) - 4.0*b*b*(x2 + y2)
}

node "algebraic_surface_test" {
    position: [3, 0, 0];
    sdf: custom(test_algebraic_surface(0.8, 0.3, 0.5));
    material: "default";
}

// ============================================================
// PRUEBA 7: COMBINACIÓN DE PRIMITIVAS NATIVAS + CUSTOM
// ============================================================

node "combined_native_custom" {
    position: [-3, -2, 0];
    sdf: union(
        sphere(0.3),
        custom(y - 0.1 * sin(x * 5.0 + w) - 0.5)
    );
    material: "default";
}

// ============================================================
// PRUEBA 8: CUSTOM CON ANIMACIÓN COMPLEJA
// ============================================================

// Superficie animada con múltiples frecuencias
fn "test_animated_surface"(amp1, freq1, amp2, freq2, t) {
    let wave1 = amp1 * sin(x * freq1 + t);
    let wave2 = amp2 * sin(z * freq2 + t * 1.3);
    let wave3 = amp1 * amp2 * sin(x * freq1 * 0.7 + z * freq2 * 0.7 + t * 0.7);
    y - (wave1 + wave2 + wave3) * 0.3
}

node "animated_surface_test" {
    position: [0, -2, 0];
    sdf: custom(test_animated_surface(1.0, 3.0, 0.8, 4.0, w));
    material: "glass";
}

// ============================================================
// PRUEBA 9: CUSTOM CON OPERACIONES MATEMÁTICAS COMPLEJAS
// ============================================================

// Superficie usando funciones matemáticas avanzadas
fn "test_math_complex_surface"() {
    let r = sqrt(x*x + y*y + z*z);
    let theta = atan2(y, x);
    let phi = acos(z / (r + 1e-6));
    
    // Armónico esférico Y²₂ (simplificado)
    let Y22 = sin(theta) * sin(theta) * cos(2.0 * phi);
    
    r - 0.5 - 0.1 * Y22 * sin(w * 2.0)
}

node "complex_math_surface_test" {
    position: [3, -2, 0];
    sdf: custom(test_math_complex_surface());
    material: "default";
}

// ============================================================
// PRUEBA 10: USO DE CONSTANTES FÍSICAS EN CUSTOM
// ============================================================

// Importar la librería física para usar sus constantes
// (En realidad las funciones se expanden textualmente)

// Onda usando constante de gravedad
fn "test_gravity_wave_with_constants"(amp, k, t) {
    let g = 9.80665;  // GRAVITY_EARTH
    let omega = sqrt(g * k);
    y - amp * sin(k * x - omega * t) * exp(-k * abs(z))
}

node "gravity_wave_constants_test" {
    position: [0, -4, 0];
    sdf: custom(test_gravity_wave_with_constants(0.2, 5.0, w));
    material: "water";
}